
import core.args;
import core.ops;



HEIGHT: @const u32 = 800;
WIDTH:  @const u32 = 600;
a: @static @const i32 = 3;
b: @static @const i32 = 6;


Array<T any>: type struct {
    items: []T;
    len: i32;
}

Vec3: type struct {
    x: i32;
    y: i32;
    z: i32;
}

Num<T any>: type struct {
    inner: T;
}

sum3: proc(a: &Vec3, b: &Vec3) -> Vec3 {
    return a + b;
}

main: proc() {
    if len(args) != 2 {
        println("Usage: program FILENAME");
        exit(0);
    }
	test: @immutable i32 = a + b;
    filename: string = args[1];
    src: string = read_to_string(filename);

    a: Vec3 = {1, 2, 3};
    b: Vec3 = {4, 5, 6};
    c: Vec3 = sum3(&a, &b);
    println("%:%:%", c.x, c.y, c.z);

}
