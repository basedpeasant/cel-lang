tokenize: proc(src: *string) -> *Token {
	x: i32 = 0;
	y: i32 = 1;
	current_string: String_Builder;
	ret: *Token = array_new(Token);
	
	for i: i32 = 0; i < src.length; i = i + 1 {
		c: u8 = src.ptr[i];
		p: u8 = 0;
		if i + 1 >= src.length {
			if current_string.length > 0 {
				token: Token = create_token(x, y, sb_to_string(&current_string), 0);
				array_append(ret, token);
				sb_clear(&current_string);
			}
			if is_delim(c) {
				token: Token = create_token(x, y, sb_to_string(&current_string), 0);
				array_append(ret, token);
			}
			break;
		} else {
			p = src.ptr[i + 1];
		}

		if c == '\n' {
			x = 0;
			y = y + 1;
		}

		if is_whitespace(c) {
			// save token
			if current_string.length > 0 {
				token: Token = create_token(x, y, sb_to_string(&current_string), 0);
				array_append(ret, token);
				sb_clear(&current_string);
			}
		} else if is_delim(c) {
			if current_string.length > 0 {
				// save the token first
				token: Token = create_token(x, y, sb_to_string(&current_string), 0);
				array_append(ret, token);
				sb_clear(&current_string);
			}
			// TODO: check if is double delim
			x = x + 1;
			sb_push(&current_string, c);
			tt: u8 = get_delim_tt(c);
			token: Token = create_token(x, y, sb_to_string(&current_string), tt);
			array_append(ret, token);
			sb_clear(&current_string);
		} else {
			x = x + 1;
			sb_push(&current_string, c);
		}

		putc(src.ptr[i]);
	}

	return ret;
}

print_tokens: proc(tokens: *Token) {
	len: u32 = array_size(tokens);
	for i: i32 = 0; i < len; i = i + 1 {
		token: Token = tokens[i];
		printf("Token: %s [%d(%d:%d)]\n".ptr, token.tok.ptr, token.tt, token.x, token.y);
	}
}

main: proc() {
	src: string = read_file_to_string("hello.ce");
	tokens: *Token = tokenize(&src);
	print_tokens(tokens);
	printf("Exiting...\n".ptr);
}
