include "core.ce";
include "tokenize.ce";
include "ast.ce";
include "static_analysis.ce";
include "codegen.ce";
include "error.ce";

print_usage: proc(i: i32) {
	// TODO: the i is a temp fix
	PROGRAM_NAME: string = "cel";
    printf("Usage: %s FILENAME\n".ptr, PROGRAM_NAME.ptr);
}

main: proc(argc: i32, argv: **u8) {
	if argc != 2 {
		print_usage(0); // TODO: this is a temp fix
		exit(0);
	}
	filename: string = string{strlen(argv[1]), argv[1]};
	src: string = read_file_to_string(filename);
    // TODO: this assignment is insanely hacky
    // we have to change this as soon as we get better scoping and imports;
    // also this will break once include is deprecated (if it gets deprecated)
	current_src = src; // defined in @./error.ce
	printf("%s".ptr, src.ptr);
	tokens: [+]Token = tokenize(&src, filename);
	expanded: [+]Token = expand_includes(tokens, filename);
	print_tokens(expanded);
	ast: Ast = ast_start(expanded);
    start_analysis(&ast);
	printf("Exiting...\n".ptr);

    codegen_start(&ast);

	array_free(expanded);
	array_free(tokens);
}
