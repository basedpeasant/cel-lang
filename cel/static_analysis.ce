

State: type struct {
    call_stack: [+]*Token, // needs to be changed
    ast: *Ast
}

push_call_stack: proc(call_stack: [+]*Token, call: *Token) {
    array_append(call_stack, call);
}

pop_call_stack: proc(call_stack: [+]*Token) -> *Token {
    index: u32 = array_size(call_stack) - 1;
    array_resize(call_stack, index); // basically subtracting one from size
    ret: *Token = call_stack[index];
    return ret; 
}

Error: type struct {
    err: string,
}

create_type_builtin: proc(kind: u8) -> *Type {
    ret: *Type = calloc(1, sizeof(Type));
    t: Type_Builtin = Type_Builtin{ 0, array_new(Attribute) };
    t.kind = kind; 
    // TODO/NOTE: this is reliant on the order of the choice type
    // which is a hack, once we introduce the syntax for this
    ret._0 = t;
    return ret;
}

create_type_pointer: proc(inner: *Type) -> *Type {
    ret: *Type = calloc(1, sizeof(Type));
    t: Type_Pointer = Type_Pointer{ inner };
    // NOTE: reliant on the order of the choice type (Type_Pointer is _1 / tag 1)
    ret._1 = t;
    ret._tag = 1;
    return ret;
}

get_builtin_proc_type: proc(name: string) -> *Type {
    // TODO: eventually we want to get rid of these (or support them as @extern procs at least) but for now we will
    // use the C functions for these
    if strcmp(name, "printf") {
        return create_type_builtin(TYPE_VOID);
    } else if strcmp(name, "calloc") {
        return create_type_builtin(TYPE_VOID_PTR);
    } else if strcmp(name, "malloc") {
        return create_type_builtin(TYPE_VOID_PTR);
    } else if strcmp(name, "sizeof") {
        return create_type_builtin(TYPE_I32);
    } else {
        return 0;
    }
}

lookup_name: proc(scopes: [+]Scope, current_scope: u32, name: string) -> *Variable_Decl_Node {
    scope: Scope = scopes[current_scope];
    for i: i32 = 0; i < array_size(scope.map); i = i + 1 {
        var_decl: *Variable_Decl_Node = &scope.map[i];
        var_type: Type = var_decl.var_type;
        // we only care about procs here
        // match t := var_type {
        //     Type_Builtin => {},
        //     Type_Pointer => {},
        //     Type_Proc => {
        //         name_tmp: *Token = t.name;
        //         name_t: string = name_tmp.tok;
        //         if strcmp(name, name_t) {
        //             return var_decl;
        //         }
        //     },
        //     Type_Array => {},
        //     Type_Dynamic_Array => {},
        //     Type_Choice => {},
        //     Type_Custom_Decl => {},
        //     Type_Custom => {},
        //     Type_Unknown => {}
        // }
        // check variables
        name_tmp: *Token = var_decl.symbol;
        name_t: string = name_tmp.tok;
        if strcmp(name, name_t) {
            return var_decl;
        }
    }
    if current_scope == 0 {
        return 0;
    } else {
        lookup_name(scopes, scope.parent_scope, name);
    }
}

// TODO: might be useless procedure - marked for removal
// only for choice/structs rn
// this is for getting the original type given only a variable name is provided
get_type_definition_from_name: proc(s: *State, current_scope: u32, var_name: *Token) -> *Type {
    ast: *Ast = s.ast;
    scopes: [+]Scope = ast.scopes;
    var_decl: *Variable_Decl_Node = lookup_name(scopes, current_scope, var_name.tok);
    if var_decl == 0 {
        return 0;
    }
    var_type: Type = var_decl.var_type;
    match v := var_type {
        Type_Builtin => {},
        Type_Pointer => {},
        Type_Proc => {},
        Type_Array => {},
        Type_Dynamic_Array => {},
        Type_Choice => {},
        Type_Custom_Decl => {
            return lookup_type(s, v.name);
        },
        Type_Custom => {
            return lookup_type(s, v.name);
        },
        Type_Unknown => {}
    }
    todo("Handle other types (maybe?)(this could also be an error)", #FILE, #LINE);
}

lookup_type: proc(s: *State, name: *Token) -> *Type {
    ast: *Ast = s.ast;
    types: [+]Type = ast.types;
    name_str: string = name.tok;
    for i: i32 = 0; i < array_size(ast.types); i = i + 1 {
        type_: *Type = &types[i];
        // We only care about Type_Custom_Decl and Type_Choice
        match t := type_ {
            Type_Builtin => {},
            Type_Pointer => {},
            Type_Proc => {},
            Type_Array => {},
            Type_Dynamic_Array => {},
            Type_Choice => {
                type_name: *Token = t.name;
                type_name_str: string = type_name.tok;
                if strcmp(type_name_str, name_str) {
                    return type_;
                }
            },
            Type_Custom_Decl => {
                type_name: *Token = t.name;
                type_name_str: string = type_name.tok;
                if strcmp(type_name_str, name_str) {
                    return type_;
                }
            },
            Type_Custom => {},
            Type_Unknown => {},
        } 
    }
    // TODO: obviously change this error because its stupid
    printf("%s\n".ptr, name_str.ptr);
    panic("^^ Undefined type", #FILE, #LINE);
}

determine_choice_tags: proc(s: *State, init: *Struct_Init_Node, choice_type: *Type_Choice) {
    ast: *Ast = s.ast;
    types: [+]Type = ast.types;
    tag: i32 = 0;
    assert(init.is_choice, "The struct initializer MUST be marked as a choice before entering this procedure", #FILE, #LINE);
    assert(array_size(init.exprs) == 1, "Choice type initializer MUST have only one value", #FILE, #LINE);
    expr: Expression = init.exprs[0];
    expr_type: *Type = match_expression(s, &expr);

    // TODO: handle when user provides other types of values
    match et := expr_type {
        Type_Builtin => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Pointer => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Proc => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Array => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Dynamic_Array => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Choice => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Custom_Decl => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Custom => {
            expr_type_name: *Token = et.name;
            expr_type_name_str: string = expr_type_name.tok;
            for j: i32 = 0; j < array_size(choice_type.fields); j = j + 1 {
                field: *Field = &choice_type.fields[j];
                field_token: *Token = field.name;
                field_name: string = field_token.tok;
                if strcmp(field_name, expr_type_name_str) {
                    init.tag = field.tag;
                    return;
                }
            }
        },
        Type_Unknown => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
    }
    panic("Could not find type specified in choice initializer in choice declaration", #FILE, #LINE); // TODO: better errors
}

get_proc_return_type: proc(p: *Variable_Decl_Node) -> *Type {
    // TODO: this is only like this because we are forced to match
    //       on every Type, once we can coerce choice types to one
    //       single type we should change this pattern where needed
    //       because otherwise we have to type out every single choice
    //       despite knowing before hand which one it is guaranteed to be
    proc_var: *Variable_Decl_Node = p;
    proc_var_type: Type = proc_var.var_type;
    match p_ := proc_var_type {
        Type_Builtin => { assert(false, "Not expecting Type_Builtin", #FILE, #LINE); },
        Type_Pointer => { assert(false, "Not expecting Type_Pointer", #FILE, #LINE); },
        Type_Proc => {
            ret_type: *Type = p_.return_type;
            return ret_type;
        },
        Type_Array => { assert(false, "Not expecting Type_Array", #FILE, #LINE); },
        Type_Dynamic_Array => { assert(false, "Not expecting Type_Dynamic_Array", #FILE, #LINE); },
        Type_Choice => { assert(false, "Not expecting Type_Choice", #FILE, #LINE); },
        Type_Custom_Decl => { assert(false, "Not expecting Type_Custom_Decl", #FILE, #LINE); },
        Type_Custom => { assert(false, "Not expecting Type_Custom", #FILE, #LINE); },
        Type_Unknown => {
            todo("Unexpected Unknown", #FILE, #LINE);
        }
    }
}

check_types: proc(t1: *Type, t2: *Type) -> bool {
    // sentinel value lol
    kind1: u8 = 69;
    builtin_kind1: u8 = 0;
    inner1: *Type = 0;
    return_type1: *Type = 0;
    array_type1: *Type = 0;
    name1: *Token = 0;
    match t1_ := t1 {
        Type_Builtin => { kind1 = 1; builtin_kind1 = t1_.kind; },
        Type_Pointer => { kind1 = 2; inner1 = t1_.inner; },
        Type_Proc => { kind1 = 3; return_type1 = t1_.return_type; },
        Type_Array => { kind1 = 4; array_type1 = t1_.array_type; },
        Type_Dynamic_Array => { kind1 = 5; array_type1 = t1_.array_type; },
        Type_Choice => { kind1 = 6; },
        Type_Custom_Decl => { kind1 = 7; name1 = t1_.name; },
        Type_Custom => { kind1 = 8; name1 = t1_.name; },
        Type_Unknown => { kind1 = 9; }
    }

    // sentinel value lol
    kind2: u8 = 69;
    builtin_kind2: u8 = 0;
    inner2: *Type = 0;
    return_type2: *Type = 0;
    array_type2: *Type = 0;
    name2: *Token = 0;
    match t2_ := t2 {
        Type_Builtin => { kind2 = 1; builtin_kind2 = t2_.kind; },
        Type_Pointer => { kind2 = 2; inner2 = t2_.inner; },
        Type_Proc => { kind2 = 3; return_type2 = t2_.return_type; },
        Type_Array => { kind2 = 4; array_type2 = t2_.array_type; },
        Type_Dynamic_Array => { kind2 = 5; array_type2 = t2_.array_type; },
        Type_Choice => { kind2 = 6; },
        Type_Custom_Decl => { kind2 = 7; name2 = t2_.name; },
        Type_Custom => { kind2 = 8; name2 = t2_.name; },
        Type_Unknown => { kind2 = 9; }
    }

    if kind1 != kind2 {
        return false;
    }

    if kind1 == 1 {
        return builtin_kind1 == builtin_kind2;
    } else if kind1 == 2 {
        return check_types(inner1, inner2);
    } else if kind1 == 3 {
        if return_type1 == 0 && return_type2 == 0 {
            return true;
        }
        if return_type1 == 0 || return_type2 == 0 {
            return false;
        }
        return check_types(return_type1, return_type2);
    } else if kind1 == 4 {
        return check_types(array_type1, array_type2);
    } else if kind1 == 5 {
        return check_types(array_type1, array_type2);
    } else if kind1 == 6 {
        return true;
    } else if kind1 == 7 {
        return strcmp(name1.tok, name2.tok);
    } else if kind1 == 8 {
        return strcmp(name1.tok, name2.tok);
    } else if kind1 == 9 {
        panic("Type_Unknown should not be in check_types", #FILE, #LINE);
    }

    assert(kind1 != 69 || kind2 != 69, "unhandled type in check_types", #FILE, #LINE);
    return false;
}

match_expression: proc(s: *State, _expr: *Expression) -> *Type {
    // TODO/NOTE: Have to do this because of bug
    expr: *Expression = _expr;
    ast: *Ast = s.ast;
    match e := expr {
        Binary_Node => { 
            // TODO: implement this please
            // todo("", #FILE, #LINE);
            // lhs_type: *Type = match_expression(s, e.lhs);
            // rhs_type: *Type = match_expression(s, e.rhs);
            // res: bool = check_types(lhs_type, rhs_type);
        },
        Number_Node => { 
            // todo("", #FILE, #LINE);
            return create_type_builtin(TYPE_I64);
        },
        Variable_Node => { 
            // lookup var_decl to check the type
            name_tok: *Token = e.symbol;
            name: string = name_tok.tok;
            var_decl: *Variable_Decl_Node = lookup_name(ast.scopes, ast.current_scope, name);
            return &var_decl.var_type;
        },
        Call_Node => { 
            // lookup proc var_decl to check the return type
            name_tok: *Token = e.name;
            name: string = name_tok.tok;
            var_decl: *Variable_Decl_Node = lookup_name(ast.scopes, ast.current_scope, name);
            builtin: *Type = get_builtin_proc_type(name);
            if builtin != 0 {
                return builtin;
            }
            if var_decl == 0 {
                printf("%s\n".ptr, name.ptr);
                panic("Could not find proc (lookup_name)\n", #FILE, #LINE);
            }
            ret_type: *Type = get_proc_return_type(var_decl);
            if ret_type != 0 {
                // TODO: need to add the line info etc
                // Sample from Go: ./main.go:10:2: declared and not used: a
                filename: string = name_tok.filename;
                printf("./%s:%d:%d: WARNING: result for call '%s' is not used\n".ptr, 
                    filename.ptr, 
                    name_tok.y, 
                    name_tok.x,
                    name.ptr);
                // NOTE: this is not correct actually
            }
            return ret_type;
        },
        String_Literal => { 
            return create_type_builtin(TYPE_STRING);
        },
        Unary_Node => { 
            if e.op == OP_REFERENCE {
                inner_type: *Type = match_expression(s, e.base);
                return create_type_pointer(inner_type);
            }
            return match_expression(s, e.base);
        },
        Struct_Init_Node => { 
            type_def: *Type = lookup_type(s, e.name);
            match t := type_def {
                Type_Builtin => {},
                Type_Pointer => {},
                Type_Proc => {},
                Type_Array => {},
                Type_Dynamic_Array => {},
                Type_Choice => {
                    // We need to construct
                    e.is_choice = true;
                    determine_choice_tags(s, e, t);
                },
                Type_Custom_Decl => {
                    // We do nothing in this case because
                    // codegen will correctly spit this out 
                    // TODO: make the error messages better, more detailed etc
                    assert(array_size(e.exprs) == array_size(t.fields), 
                        "struct initializer must match the number of fields in the struct definition", 
                        #FILE, 
                        #LINE
                    );
                },
                Type_Custom => {},
                Type_Unknown => {},
            }
            //todo("", #FILE, #LINE);
        },
        Array_Literal => { 
            todo("", #FILE, #LINE);
        },
    } 
}

sa_walk_var_decl: proc(s: *State, v: *Variable_Decl_Node) {
    // TODO: need to check every type to see if the rhs matches the 
    //       declared type
    var_type: *Type = &v.var_type;
    match t := var_type {
        Type_Builtin => {},
        Type_Pointer => {},
        Type_Proc => {
            // TODO: I guess need to check default values here?
            if t.block != 0 {
                sa_walk_block(s, t.block);
            }
        },
        Type_Array => {},
        Type_Dynamic_Array => {},
        Type_Choice => {},
        Type_Custom_Decl => {},
        Type_Custom => {
            // todo("static analysis for custom types", #FILE, #LINE);
            match_expression(s, v.rhs);
        },
        Type_Unknown => {
            // inference
            resolved_type: *Type = match_expression(s, v.rhs);
            t.resolved = true;
            t.type_ = resolved_type;
        }
    }
}

sa_walk_decl: proc(s: *State, _decl: *Decl_Node) {
    // TODO/NOTE: Have to do this because of bug
    decl: *Decl_Node = _decl; 
    match d := decl {
        Variable_Decl_Node => {
            sa_walk_var_decl(s, d);
        }
    }
}

// this is specifically for the matchnodes btw (just avoiding duplications)
sa_match_subject_inference: proc(s: *State, v: *Variable_Decl_Node) {
    // Putting this here because otherwise would sa_walk_expression_statement_with_block
    // function is going to be too long
    subject_type_container: Type = v.var_type;
    match subject_type := subject_type_container {
        // TODO: better errors
        Type_Builtin => { panic("unsupported here", #FILE, #LINE); },
        Type_Pointer => { panic("unsupported here", #FILE, #LINE); },
        Type_Proc => { panic("unsupported here", #FILE, #LINE); },
        Type_Array => { panic("unsupported here", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("unsupported here", #FILE, #LINE); },
        Type_Choice => { panic("unsupported here", #FILE, #LINE); },
        Type_Custom_Decl => { panic("unsupported here", #FILE, #LINE); },
        Type_Custom => { panic("unsupported here", #FILE, #LINE); },
        Type_Unknown => { 
            sa_walk_var_decl(s, v);
        },
    }
}

get_scope_from_id: proc(scopes: [+]Scope, id: u32) -> *Scope {
    for i: i32 = 0; i < array_size(scopes); i = i + 1 {
        scope: *Scope = &scopes[i];
        if scope.id == id {
            return scope;
        }
    }
    return 0;
}

// assumption: provided type is known to be type_unknown
get_type_unknown_inner: proc(type_unknown: *Type) -> *Type {
    match t := type_unknown {
        // TODO: better errors
        Type_Builtin => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Builtin ", #FILE, #LINE); },
        Type_Pointer => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Pointer ", #FILE, #LINE); },
        Type_Proc => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Proc ", #FILE, #LINE); },
        Type_Array => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Array ", #FILE, #LINE); },
        Type_Dynamic_Array => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Dynamic_Array ", #FILE, #LINE); },
        Type_Choice => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Choice ", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Custom_Decl ", #FILE, #LINE); },
        Type_Custom => { unreachable("FUNCTION 'get_type_unknown_inner' NOT MEANT TO BE USED WITH Type_Custom ", #FILE, #LINE); },
        Type_Unknown => { 
            assert(t.resolved, "type in match subject has not been resolved successfully", #FILE, #LINE);
            return t.type_;
        },
    }
}

// assumption: provided type is known to be type_choice
get_type_choice_inner: proc(type_choice: *Type) -> *Type_Choice {
    match t := type_choice {
        Type_Builtin => { panic("Cannot get Type_Builtin here", #FILE, #LINE); },
        Type_Pointer => { panic("Cannot get Type_Pointer here", #FILE, #LINE); },
        Type_Proc => { panic("Cannot get Type_Proc here", #FILE, #LINE); },
        Type_Array => { panic("Cannot get Type_Array here", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("Cannot get Type_Dynamic_Array here", #FILE, #LINE); },
        Type_Choice => { 
            return t;
        },
        Type_Custom_Decl => { 
            panic("Type must be a choice", #FILE, #LINE); 
        },
        Type_Custom => { unreachable("Cannot get Type_Unknown here", #FILE, #LINE); },
        Type_Unknown => { unreachable("Cannot get Type_Unknown here", #FILE, #LINE); },
    }
}

sa_walk_expression_statement_with_block: proc(s: *State, es: *Expression_Statement_With_Block) {
    ast: *Ast = s.ast;
    scopes: [+]Scope = ast.scopes;
    match eswb := es {
        // TODO:
        If_Node => {},
        // TODO:
        For_Node => {},
        Match_Node => {
            // What do we need to do?
            // - We must compare each arm with the original choice type
            //     - Get it from the subject
            // - set tags?
            local_block: *Block_Node = &eswb.blocks[0];
            local_block_scope: *Scope = get_scope_from_id(scopes, local_block.scope);
            // this is where the Match_Node was declared
            match_node_scope_id: u32 = local_block_scope.parent_scope;
            subject: *Variable_Decl_Node = eswb.subject;
            sa_match_subject_inference(s, subject);

            subject_type_def: *Type = 0;
            // TODO: wondering if need to fail if cannot find the definition HERE or 
            //       need to check if maybe it needs to happen somewhere else
            subject_type_container: *Type = get_type_unknown_inner(&subject.var_type);
            choice_type: *Type_Choice = 0;

            //subject_type_container = lookup_type(s, symbol);
            // TODO: fix this duplication mental illness later
            // TODO: also probably needs to be unreachable instead of panic(?) + add better error messages
            match subject_type := subject_type_container {
                Type_Builtin => { panic("Cannot put Type_Builtin in a match statement", #FILE, #LINE); },
                Type_Pointer => { panic("Cannot put Type_Pointer in a match statement", #FILE, #LINE); },
                Type_Proc => { panic("Cannot put Type_Proc in a match statement", #FILE, #LINE); },
                Type_Array => { panic("Cannot put Type_Array in a match statement", #FILE, #LINE); },
                Type_Dynamic_Array => { panic("Cannot put Type_Dynamic_Array in a match statement", #FILE, #LINE); },
                Type_Choice => { panic("Cannot put Type_Choice in a match statement", #FILE, #LINE); },
                Type_Custom_Decl => { panic("Cannot put Type_Custom_Decl in a match statement", #FILE, #LINE); },
                Type_Custom => { 
                    subject_type_def = lookup_type(s, subject_type.name);
                    choice_type = get_type_choice_inner(subject_type_def);
                },
                Type_Unknown => {
                    unreachable("", #FILE, #LINE);
                },
            }

            // TODO: better error message probably (do we even need this?)
            assert(choice_type != 0 && subject_type_def != 0, "", #FILE, #LINE);
            assert(array_size(eswb.blocks) == array_size(choice_type.fields), "", #FILE, #LINE);

            // TODO: this needs to be changed once we introduce the "_" in match blocks
            if array_size(eswb.fields) != array_size(choice_type.fields) {
                // TODO: better error message probably
                compile_error(eswb.token, "Match arms are not exhaustive, needs to cover all arms of the underlying Choice Type");
            }
            for i: i32 = 0; i < array_size(eswb.fields); i = i + 1 {
                field: *Field = &eswb.fields[i];
                field_name: *Token = field.name;
                found: bool = false;
                for j: i32 = 0; j < array_size(choice_type.fields); j = j + 1 {
                    field_j: *Field = &choice_type.fields[j];
                    field_j_name: *Token = field_j.name;
                    if strcmp(field_j_name.tok, field_name.tok) {
                        field.tag = field_j.tag;
                        found = true;
                    }
                }
                // TODO: needs a good error
                assert(found, "Could not find arm in choice definition", #FILE, #LINE);
            }
        }
    }
}

sa_walk_block: proc(s: *State, block: *Block_Node) {
    isRoot: bool = block.scope == 0;
    ast: *Ast = s.ast;
    ast.current_scope = block.scope; 
    for i: i32 = 0; i < array_size(block.statements); i = i + 1 {
        statement: *Statement = &block.statements[i];
        // TODO: potentially too much nesting going on here, not sure
        match st := statement {
            Expression_Statement => {
                stmt: *Expression_Statement = st;
                match es := stmt {
                    Expression => {
                        match_expression(s, es);
                    },
                    Expression_Statement_With_Block => {
                        // Do nothing with if and for (for now)
                        sa_walk_expression_statement_with_block(s, es);
                    }
                }
            },
            Decl_Node => {
                sa_walk_decl(s, st); 
            },
            Return_Node => {
                // do nothing (for now)
            }
        }
    }

}

start_analysis: proc(ast: *Ast) {
    printf("Starting Static Analysis...\n".ptr);
    s: State = State { 0, ast };
    sa_walk_block(&s, &ast.root_block);
}
