        Type_Proc => { panic("Cannot get Type_Proc here", #FILE, #LINE); },
        Type_Array => { panic("Cannot get Type_Array here", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("Cannot get Type_Dynamic_Array here", #FILE, #LINE); },
        Type_Choice => { 
            return t;
        },
        Type_Custom_Decl => { 
            panic("Type must be a choice", #FILE, #LINE); 
        },
        Type_Custom => { unreachable("Cannot get Type_Custom here", #FILE, #LINE); },
        Type_Unknown => { unreachable("Cannot get Type_Unknown here", #FILE, #LINE); },
    }

}

sa_check_custom_type_exists: proc(ast: *Ast, type_name: *Token) -> bool {
    types: [+]Type = ast.types;
    for i: i32 = 0; i < array_size(types); i = i + 1 {
        type_declaration: *Type = &types[i];
        match t_inner := type_declaration {
            Type_Builtin => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Pointer => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Proc => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Array => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Dynamic_Array => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Choice => {
                type_name_str: string = type_name.tok;
                t_inner_name: *Token = t_inner.name;
                t_inner_name_str: string = t_inner_name.tok;
                if strcmp(type_name_str, t_inner_name_str) {
                    return true;
                }
            },
            Type_Custom_Decl => {
                type_name_str: string = type_name.tok;
                t_inner_name: *Token = t_inner.name;
                t_inner_name_str: string = t_inner_name.tok;
                if strcmp(type_name_str, t_inner_name_str) {
                    return true;
                }
            },
            Type_Custom => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            },
            Type_Unknown => {
                panic("Type should not be stored in the ast.types array as its not a user defined type", #FILE, #LINE);
            }
        }
    }

    return false; 
}

// Very hacky way of adding the variable declaration statement to each match block
sa_create_match_statement_rhs: proc(var_decl: *Variable_Decl_Node, field: *Field, subject_rhs: *Expression, needs_deref: bool) {
    // rhs: *Expression = 0;
    // &akldlasd._X;

    //   Variable Declaration:
    // name: 'a'
    // Initializer:
    //   BinaryOp: .
    //     lhs:
    //       UnaryOp: &
    //         expr:
    //         ...(subject_rhs)
    //     rhs:
    //       Variable_Node (tag) 
    // TODO: check deref shiza here
    // lhs
    lhs_tmp: Expression = subject_rhs[0];
    lhs: *Expression = calloc(1, sizeof(Expression));
    memcpy(lhs, &lhs_tmp, sizeof(Expression));

    // rhs
    sb: String_Builder;
    sb_push(&sb, '_');
    sb_push_int(&sb, field.tag);
    tag_name: string = sb_to_string(&sb);
    sb_free(&sb);
    // we have to create the token for codegen purposes
    tag_token_tmp: Token = create_token(0-1, 0-1, tag_name, "__BUILTIN__");
    tag_token: *Token = calloc(1, sizeof(Token));
    memcpy(tag_token, &tag_token_tmp, sizeof(Token));
    tag: Variable_Node = Variable_Node{ tag_token, true };
    rhs_tmp: Expression = Expression{ tag };
    rhs: *Expression = calloc(1, sizeof(Expression));
    memcpy(rhs, &rhs_tmp, sizeof(Expression));

    bin: Binary_Node = Binary_Node{ OP_ACCESS, lhs, rhs, needs_deref };
    bin_expr_tmp: Expression = Expression{ bin };
    bin_expr: *Expression = calloc(1, sizeof(Expression));
    memcpy(bin_expr, &bin_expr_tmp, sizeof(Expression));

    unary: Unary_Node = Unary_Node{ OP_REFERENCE, bin_expr, 0 };

    final_expr: *Expression = calloc(1, sizeof(Expression));
    final_expr_tmp: Expression = Expression{ unary };
    memcpy(final_expr, &final_expr_tmp, sizeof(Expression));
    var_decl.rhs = final_expr;
}

sa_add_statement_to_match_blocks: proc(ast: *Ast, m: *Match_Node, choice_type: *Type_Choice) {
    // assuming all the fields are custom declared types
    // we have to check if their valid and get their respective declarations
    subject: *Variable_Decl_Node = m.subject;
    for i: i32 = 0; i < array_size(m.fields); i = i + 1 {
        field: Field = m.fields[i];
        current_block: *Block_Node = &m.blocks[i]; // TODO/NOTE: not sure if this should be i or tag
        current_scope_id: u32 = current_block.scope; // TODO: add the variable to the scope
        // TODO: do we even need this check? It'll error earlier if the arm type doesn't exist
        exists: bool = sa_check_custom_type_exists(ast, field.name);
        if !exists {
            compile_error(field.name, "Undefined Type in Match arm");
        }
        // -----
        var_type_custom: Type_Custom = Type_Custom{ field.name, 0 };
        var_type: Type;
        // the way in which we wrap this with a pointer feels very stupid
        // var_type = Type{ var_type_custom };
        inner: *Type = calloc(1, sizeof(Type));
        inner_tmp: Type = Type{ var_type_custom };
        memcpy(inner, &inner_tmp, sizeof(Type));
        var_type_pointer: Type_Pointer = Type_Pointer{ inner };
        // TODO: need to change this once switched to the cel compiler because
        //       currently the rust compiler does not support struct initializers in 
        //       expressions (lol)
        tmp: Type = Type{ var_type_pointer };
        var_type = tmp;

        // rhs: &subject._X;
        var_decl: Variable_Decl_Node = Variable_Decl_Node{ subject.symbol, 0, var_type, false };
        sa_create_match_statement_rhs(&var_decl, &field, subject.rhs, m.needs_deref);
        decl: Decl_Node = Decl_Node{ var_decl };
        stmt_tmp: Statement = Statement{ decl };
        stmt: *Statement = calloc(1, sizeof(Statement));
        memcpy(stmt, &stmt_tmp, sizeof(Statement));
        // TODO: assert they are really there (?)
        current_block.statements[0] = stmt[0]; // THIS SHOULD BE WHERE THE RESERVE IS FOR MATCHES
        scope: *Scope = get_scope_from_id(ast.scopes, current_scope_id);
        array_append(scope.map, var_decl);
    }
}

sa_walk_expression_statement_with_block: proc(s: *State, es: *Expression_Statement_With_Block) {
    ast: *Ast = s.ast;
    scopes: [+]Scope = ast.scopes;
    match eswb := es {
        // TODO:
        If_Node => {},
        // TODO:
        For_Node => {},
        Match_Node => {
            // What do we need to do?
            // - We must compare each arm with the original choice type
            //     - Get it from the subject
            // - set tags?
            local_block: *Block_Node = &eswb.blocks[0];
            local_block_scope: *Scope = get_scope_from_id(scopes, local_block.scope);
            // this is where the Match_Node was declared
            match_node_scope_id: u32 = local_block_scope.parent_scope;
            subject: *Variable_Decl_Node = eswb.subject;
            sa_match_subject_inference(s, subject);

            subject_type_def: *Type = 0;
            // TODO: wondering if need to fail if cannot find the definition HERE or 
            //       need to check if maybe it needs to happen somewhere else
            subject_type_container: *Type = get_type_unknown_inner(&subject.var_type);
            choice_type: *Type_Choice = 0;

            //subject_type_container = lookup_type(s, symbol);
            // TODO: we need to potentially wrap the subject so its a pointer (?)
            // TODO: fix this duplication mental illness later
            // TODO: also probably needs to be unreachable instead of panic(?) + add better error messages
            match subject_type := subject_type_container {
                Type_Builtin => { panic("Cannot put Type_Builtin in a match statement", #FILE, #LINE); },
                Type_Pointer => {
                    t: *Type_Custom = get_custom_type_from_pointer_inner(subject_type);
                    subject_type_def = lookup_type(s, t.name);
                    choice_type = get_type_choice_inner(subject_type_def);
                    eswb.needs_deref = true;
                },
                Type_Proc => { panic("Cannot put Type_Proc in a match statement", #FILE, #LINE); },
                Type_Array => { panic("Cannot put Type_Array in a match statement", #FILE, #LINE); },
                Type_Dynamic_Array => { panic("Cannot put Type_Dynamic_Array in a match statement", #FILE, #LINE); },
                Type_Choice => { panic("Cannot put Type_Choice in a match statement", #FILE, #LINE); },
                Type_Custom_Decl => { panic("Cannot put Type_Custom_Decl in a match statement", #FILE, #LINE); },
                Type_Custom => { 
                    subject_type_def = lookup_type(s, subject_type.name);
                    choice_type = get_type_choice_inner(subject_type_def);
                },
                Type_Unknown => {
                    unreachable("", #FILE, #LINE);
                },
            }

            // TODO: better error message probably (do we even need this?)
            assert(choice_type != 0 && subject_type_def != 0, "", #FILE, #LINE);
            assert(array_size(eswb.blocks) == array_size(choice_type.fields), "", #FILE, #LINE);

            // TODO: this needs to be changed once we introduce the "_" in match blocks
            if array_size(eswb.fields) != array_size(choice_type.fields) {
                // TODO: better error message probably
                compile_error(eswb.token, "Match arms are not exhaustive, needs to cover all arms of the underlying Choice Type");
            }
            for i: i32 = 0; i < array_size(eswb.fields); i = i + 1 {
                field: *Field = &eswb.fields[i];
                field_name: *Token = field.name;
                found: bool = false;
                for j: i32 = 0; j < array_size(choice_type.fields); j = j + 1 {
                    field_j: *Field = &choice_type.fields[j];
                    field_j_name: *Token = field_j.name;
                    if strcmp(field_j_name.tok, field_name.tok) {
                        field.tag = field_j.tag;
                        found = true;
                    }
                }
                // TODO: needs a better error
                if !found {
                    compile_error(field_name, "Could not find arm in choice definition");
                }
            }

            // TODO: add the statements here 
            sa_add_statement_to_match_blocks(ast, eswb, choice_type);

            // the blocks still need to be analyzed
            for i: i32 = 0; i < array_size(eswb.blocks); i = i + 1 {
                sa_walk_block(s, &eswb.blocks[i]);
            }
        }
    }
}

sa_check_call_result_is_used: proc(s: *State, expr: *Expression) {
    ast: *Ast = s.ast;
    match e := expr {
        Binary_Node => {},
        Number_Node => {},
        Variable_Node => {},
        Call_Node => {
            name_tok: *Token = e.name;
            name: string = name_tok.tok;
            is_void: bool = false;
            var_decl: *Variable_Decl_Node = lookup_name(ast.scopes, ast.current_scope, name);
            builtin: *Type = get_builtin_proc_type(name);
            if var_decl == 0 && builtin == 0 {
                printf("%s\n".ptr, name.ptr);
                panic("Could not find proc (lookup_name)\n", #FILE, #LINE);
            } else if var_decl == 0 && builtin != 0 {
                match b := builtin {
                    Type_Builtin => {
                        if b.kind == TYPE_VOID {
                            is_void = true;
                        }
                    },
                    Type_Pointer => {},
                    Type_Proc => {},
                    Type_Array => {},
                    Type_Dynamic_Array => {},
                    Type_Choice => {},
                    Type_Custom_Decl => {},
                    Type_Custom => {},
                    Type_Unknown => {}
                }
            } else {
                // TODO: pretty sure this assert is needed but perhaps this actually should be checked elsewhere
                // assert(var_decl != 0 && builtin != 0, "TODO: need to handle case where user names the function with a builtin proc", #FILE, #LINE);
            }
            ret_type: *Type;
            if builtin != 0 {
                ret_type = builtin;
            } else {
                ret_type = get_proc_return_type(var_decl);
            }

            if ret_type != 0 && !is_void {
                // TODO: need to add the line info etc
                // Sample from Go: ./main.go:10:2: declared and not used: a
                // TODO: need to change this to support the new compile format in @error
                filename: string = name_tok.filename;
                printf("./%s:%d:%d: WARNING: result for call '%s' is not used\n".ptr, 
                    filename.ptr, 
                    name_tok.y, 
                    name_tok.x,
                    name.ptr);
                // NOTE: this is not correct actually
            }

        },
        String_Literal => {},
        Unary_Node => {},
        Struct_Init_Node => {},
        Array_Literal => {},
    }
}

sa_walk_block: proc(s: *State, block: *Block_Node) {
    isRoot: bool = block.scope == 0;
    ast: *Ast = s.ast;
    ast.current_scope = block.scope; 
    for i: i32 = 0; i < array_size(block.statements); i = i + 1 {
        statement: *Statement = &block.statements[i];
        // TODO: potentially too much nesting going on here, not sure
        match st := statement {
            Expression_Statement => {
                stmt: *Expression_Statement = st;
                match es := stmt {
                    Expression => {
                        sa_check_call_result_is_used(s, es);
                        match_expression(s, es);
                    },
                    Expression_Statement_With_Block => {
                        // Do nothing with if and for (for now)
                        sa_walk_expression_statement_with_block(s, es);
                    }
                }
            },
            Decl_Node => {
                sa_walk_decl(s, st); 
            },
            Return_Node => {
                // do nothing (for now)
            },
            Reserve_Statement => {
                panic("Reserve_Statement should not be present in the blocknode during static analysis", #FILE, #LINE);
            }
        }
    }

}

start_analysis: proc(ast: *Ast) {
    printf("Starting Static Analysis...\n".ptr);
    s: State = State { 0, ast };
    sa_walk_block(&s, &ast.root_block);
}
