

State: type struct {
    call_stack: [+]*Token, // needs to be changed
    ast: *Ast
}

push_call_stack: proc(call_stack: [+]*Token, call: *Token) {
    array_append(call_stack, call);
}

pop_call_stack: proc(call_stack: [+]*Token) -> *Token {
    index: u32 = array_size(call_stack) - 1;
    array_resize(call_stack, index); // basically subtracting one from size
    ret: *Token = call_stack[index];
    return ret; 
}

Error: type struct {
    err: string,
}

// not accurate name but anyway I just want a smaller subset of types
// where you can't drill down further
Concrete_Type: type choice {
    Type_Builtin,
    Type_Custom,
}

unknown_type_name_error: proc(name: *Token) {
    sb: String_Builder;
    name_str: string = name.tok;
    sb_push_str(&sb, "Unknown type name '");
    sb_push_str(&sb, name_str);
    sb_push_str(&sb, "'");
    msg: string = sb_to_string(&sb);
    compile_error(name, msg);
}

create_type_builtin: proc(kind: u8) -> *Type {
    ret: *Type = calloc(1, sizeof(Type));
    t: Type_Builtin = Type_Builtin{ 0, array_new(Attribute) };
    t.kind = kind; 
    // TODO/NOTE: this is reliant on the order of the choice type
    // which is a hack, once we introduce the syntax for this
    ret._0 = t;
    return ret;
}

create_type_pointer: proc(inner: *Type) -> *Type {
    ret: *Type = calloc(1, sizeof(Type));
    t: Type_Pointer = Type_Pointer{ inner };
    // NOTE: reliant on the order of the choice type (Type_Pointer is _1 / tag 1)
    ret._1 = t;
    ret._tag = 1;
    return ret;
}

get_builtin_proc_type: proc(name: string) -> *Type {
    // TODO: eventually we want to get rid of these (or support them as @extern procs at least) but for now we will
    // use the C functions for these
    if strcmp(name, "printf") {
        return create_type_builtin(TYPE_VOID);
    } else if strcmp(name, "calloc") {
        return create_type_builtin(TYPE_VOID_PTR);
    } else if strcmp(name, "malloc") {
        return create_type_builtin(TYPE_VOID_PTR);
    } else if strcmp(name, "sizeof") {
        return create_type_builtin(TYPE_I32);
    } else {
        return 0;
    }
}

lookup_name: proc(scopes: [+]Scope, current_scope: u32, name: string) -> *Variable_Decl_Node {
    scope: Scope = scopes[current_scope];
    for i: i32 = 0; i < array_size(scope.map); i = i + 1 {
        var_decl: *Variable_Decl_Node = &scope.map[i];
        var_type: Type = var_decl.var_type;
        // we only care about procs here
        // match t := var_type {
        //     Type_Builtin => {},
        //     Type_Pointer => {},
        //     Type_Proc => {
        //         name_tmp: *Token = t.name;
        //         name_t: string = name_tmp.tok;
        //         if strcmp(name, name_t) {
        //             return var_decl;
        //         }
        //     },
        //     Type_Array => {},
        //     Type_Dynamic_Array => {},
        //     Type_Choice => {},
        //     Type_Custom_Decl => {},
        //     Type_Custom => {},
        //     Type_Unknown => {}
        // }
        // check variables
        name_tmp: *Token = var_decl.symbol;
        name_t: string = name_tmp.tok;
        if strcmp(name, name_t) {
            return var_decl;
        }
    }
    if current_scope == 0 {
        return 0;
    } else {
        return lookup_name(scopes, scope.parent_scope, name);
    }
}

// TODO: might be useless procedure - marked for removal
// only for choice/structs rn
// this is for getting the original type given only a variable name is provided
get_type_definition_from_name: proc(s: *State, current_scope: u32, var_name: *Token) -> *Type {
    ast: *Ast = s.ast;
    scopes: [+]Scope = ast.scopes;
    var_decl: *Variable_Decl_Node = lookup_name(scopes, current_scope, var_name.tok);
    if var_decl == 0 {
        return 0;
    }
    var_type: Type = var_decl.var_type;
    match v := var_type {
        Type_Builtin => {},
        Type_Pointer => {},
        Type_Proc => {},
        Type_Array => {},
        Type_Dynamic_Array => {},
        Type_Choice => {},
        Type_Custom_Decl => {
            return lookup_type(s, v.name);
        },
        Type_Custom => {
            return lookup_type(s, v.name);
        },
        Type_Unknown => {}
    }
    todo("Handle other types (maybe?)(this could also be an error)", #FILE, #LINE);
}

lookup_type: proc(s: *State, name: *Token) -> *Type {
    ast: *Ast = s.ast;
    types: [+]Type = ast.types;
    name_str: string = name.tok;
    for i: i32 = 0; i < array_size(ast.types); i = i + 1 {
        type_: *Type = &types[i];
        // We only care about Type_Custom_Decl and Type_Choice
        match t := type_ {
            Type_Builtin => {},
            Type_Pointer => {},
            Type_Proc => {},
            Type_Array => {},
            Type_Dynamic_Array => {},
            Type_Choice => {
                type_name: *Token = t.name;
                type_name_str: string = type_name.tok;
                if strcmp(type_name_str, name_str) {
                    return type_;
                }
            },
            Type_Custom_Decl => {
                type_name: *Token = t.name;
                type_name_str: string = type_name.tok;
                if strcmp(type_name_str, name_str) {
                    return type_;
                }
            },
            Type_Custom => {},
            Type_Unknown => {},
        } 
    }
    return 0;
}

match_tags: proc(init: *Struct_Init_Node, choice_type: *Type_Choice, expr_type: *Type) -> bool {
    match et := expr_type {
        Type_Builtin => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Pointer => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Proc => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Array => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Dynamic_Array => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Choice => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Custom_Decl => { todo("Cannot use expressions in choice intialization", #FILE, #LINE); },
        Type_Custom => {
            expr_type_name: *Token = et.name;
            expr_type_name_str: string = expr_type_name.tok;
            for j: i32 = 0; j < array_size(choice_type.fields); j = j + 1 {
                field: *Field = &choice_type.fields[j];
                field_token: *Token = field.name;
                field_name: string = field_token.tok;
                if strcmp(field_name, expr_type_name_str) {
                    init.tag = field.tag;
                    return true;
                }
            }
        },
        Type_Unknown => {
            assert(et.resolved, "Type_Unknown has appeared without being resolved, something is wrong", #FILE, #LINE);
            inner: *Type = et.type_;
            return match_tags(init, choice_type, inner);
        },
    }
    return false;
}

determine_choice_tags: proc(s: *State, init: *Struct_Init_Node, choice_type: *Type_Choice) {
    ast: *Ast = s.ast;
    types: [+]Type = ast.types;
    tag: i32 = 0;
    assert(init.is_choice, "The struct initializer MUST be marked as a choice before entering this procedure", #FILE, #LINE);
    assert(array_size(init.exprs) == 1, "Choice type initializer MUST have only one value", #FILE, #LINE);
    expr: Expression = init.exprs[0];
    expr_type: *Type = match_expression(s, &expr);
    success: bool = match_tags(init, choice_type, expr_type);

    if !success {
        panic("Could not find type specified in choice initializer in choice declaration", #FILE, #LINE); // TODO: better errors
    }
}

get_proc_return_type: proc(p: *Variable_Decl_Node) -> *Type {
    // TODO: this is only like this because we are forced to match
    //       on every Type, once we can coerce choice types to one
    //       single type we should change this pattern where needed
    //       because otherwise we have to type out every single choice
    //       despite knowing before hand which one it is guaranteed to be
    proc_var: *Variable_Decl_Node = p;
    proc_var_type: Type = proc_var.var_type;
    match p_ := proc_var_type {
        Type_Builtin => { panic("Not expecting Type_Builtin", #FILE, #LINE); },
        Type_Pointer => { panic("Not expecting Type_Pointer", #FILE, #LINE); },
        Type_Proc => {
            ret_type: *Type = p_.return_type;
            return ret_type;
        },
        Type_Array => { panic("Not expecting Type_Array", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("Not expecting Type_Dynamic_Array", #FILE, #LINE); },
        Type_Choice => { panic("Not expecting Type_Choice", #FILE, #LINE); },
        Type_Custom_Decl => { panic("Not expecting Type_Custom_Decl", #FILE, #LINE); },
        Type_Custom => { panic("Not expecting Type_Custom", #FILE, #LINE); },
        Type_Unknown => {
            todo("Unexpected Unknown", #FILE, #LINE);
        }
    }
}

get_proc_default_values: proc(p: *Variable_Decl_Node) -> [+]Expression {
    // TODO: this is only like this because we are forced to match
    //       on every Type, once we can coerce choice types to one
    //       single type we should change this pattern where needed
    //       because otherwise we have to type out every single choice
    //       despite knowing before hand which one it is guaranteed to be
    proc_var: *Variable_Decl_Node = p;
    proc_var_type: Type = proc_var.var_type;
    match p_ := proc_var_type {
        Type_Builtin => { panic("Not expecting Type_Builtin", #FILE, #LINE); },
        Type_Pointer => { panic("Not expecting Type_Pointer", #FILE, #LINE); },
        Type_Proc => {
            ret_type: [+]Expression = p_.default_vals;
            return ret_type;
        },
        Type_Array => { panic("Not expecting Type_Array", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("Not expecting Type_Dynamic_Array", #FILE, #LINE); },
        Type_Choice => { panic("Not expecting Type_Choice", #FILE, #LINE); },
        Type_Custom_Decl => { panic("Not expecting Type_Custom_Decl", #FILE, #LINE); },
        Type_Custom => { panic("Not expecting Type_Custom", #FILE, #LINE); },
        Type_Unknown => {
            todo("Unexpected Unknown", #FILE, #LINE);
        }
    }
}

get_proc_args: proc(p: *Variable_Decl_Node) -> [+]Variable_Decl_Node {
    // TODO: this is only like this because we are forced to match
    //       on every Type, once we can coerce choice types to one
    //       single type we should change this pattern where needed
    //       because otherwise we have to type out every single choice
    //       despite knowing before hand which one it is guaranteed to be
    proc_var: *Variable_Decl_Node = p;
    proc_var_type: Type = proc_var.var_type;
    match p_ := proc_var_type {
        Type_Builtin => { panic("Not expecting Type_Builtin", #FILE, #LINE); },
        Type_Pointer => { panic("Not expecting Type_Pointer", #FILE, #LINE); },
        Type_Proc => {
            ret_type: [+]Variable_Decl_Node = p_.args;
            return ret_type;
        },
        Type_Array => { panic("Not expecting Type_Array", #FILE, #LINE); },
        Type_Dynamic_Array => { panic("Not expecting Type_Dynamic_Array", #FILE, #LINE); },
        Type_Choice => { panic("Not expecting Type_Choice", #FILE, #LINE); },
        Type_Custom_Decl => { panic("Not expecting Type_Custom_Decl", #FILE, #LINE); },
        Type_Custom => { panic("Not expecting Type_Custom", #FILE, #LINE); },
        Type_Unknown => {
            todo("Unexpected Unknown", #FILE, #LINE);
        }
    }
}

check_types: proc(t1: *Type, t2: *Type) -> bool {
    // sentinel value lol
    kind1: u8 = 69;
    builtin_kind1: u8 = 0;
    inner1: *Type = 0;
    return_type1: *Type = 0;
    array_type1: *Type = 0;
    name1: *Token = 0;
    match t1_ := t1 {
        Type_Builtin => { kind1 = 1; builtin_kind1 = t1_.kind; },
        Type_Pointer => { kind1 = 2; inner1 = t1_.inner; },
        Type_Proc => { kind1 = 3; return_type1 = t1_.return_type; },
        Type_Array => { kind1 = 4; array_type1 = t1_.array_type; },
        Type_Dynamic_Array => { kind1 = 5; array_type1 = t1_.array_type; },
        Type_Choice => { kind1 = 6; },
        Type_Custom_Decl => { kind1 = 7; name1 = t1_.name; },
        Type_Custom => { kind1 = 8; name1 = t1_.name; },
        Type_Unknown => { kind1 = 9; }
    }

    // sentinel value lol
    kind2: u8 = 69;
    builtin_kind2: u8 = 0;
    inner2: *Type = 0;
    return_type2: *Type = 0;
    array_type2: *Type = 0;
    name2: *Token = 0;
    match t2_ := t2 {
        Type_Builtin => { kind2 = 1; builtin_kind2 = t2_.kind; },
        Type_Pointer => { kind2 = 2; inner2 = t2_.inner; },
        Type_Proc => { kind2 = 3; return_type2 = t2_.return_type; },
        Type_Array => { kind2 = 4; array_type2 = t2_.array_type; },
        Type_Dynamic_Array => { kind2 = 5; array_type2 = t2_.array_type; },
        Type_Choice => { kind2 = 6; },
        Type_Custom_Decl => { kind2 = 7; name2 = t2_.name; },
        Type_Custom => { kind2 = 8; name2 = t2_.name; },
        Type_Unknown => { kind2 = 9; }
    }

    if kind1 != kind2 {
        return false;
    }

    if kind1 == 1 {
        return builtin_kind1 == builtin_kind2;
    } else if kind1 == 2 {
        return check_types(inner1, inner2);
    } else if kind1 == 3 {
        if return_type1 == 0 && return_type2 == 0 {
            return true;
        }
        if return_type1 == 0 || return_type2 == 0 {
            return false;
        }
        return check_types(return_type1, return_type2);
    } else if kind1 == 4 {
        return check_types(array_type1, array_type2);
    } else if kind1 == 5 {
        return check_types(array_type1, array_type2);
    } else if kind1 == 6 {
        return true;
    } else if kind1 == 7 {
        return strcmp(name1.tok, name2.tok);
    } else if kind1 == 8 {
        return strcmp(name1.tok, name2.tok);
    } else if kind1 == 9 {
        panic("Type_Unknown should not be in check_types", #FILE, #LINE);
    }

    assert(kind1 != 69 || kind2 != 69, "unhandled type in check_types", #FILE, #LINE);
    return false;
}

construct_type_custom: proc(name: *Token) -> *Type {
    // NOTE: this does not lookup the name, this should be done before calling this function
    // ASSUMPTION: type name has already been checked to have a declaration
    ret_inner: Type_Custom = Type_Custom{ name, 0 };
    ret: *Type = calloc(1, sizeof(Type));
    ret_tmp: Type = Type{ ret_inner };
    memcpy(ret, &ret_tmp, sizeof(Type));
    return ret;
}

// very stupid but necessary for the time being
array_get: proc(type_size: i32, arr: void_ptr, index: i32) -> void_ptr {
    assert(arr != 0, "Cannot provide a null array to array_get", #FILE, #LINE);
    if  index >= array_size(arr) || index < 0 {
        panic("invalid index for array_get", #FILE, #LINE);
    }

    return arr + (index * type_size);
}

// deep_copy_type: returns a freshly-allocated Type with the same structure,
// following inner pointers and allocating fresh [+] arrays where needed.
// For variants we never recurse into during generic substitution
// (Type_Builtin, Type_Custom, Type_Choice, Type_Custom_Decl, Type_Unknown),
// a single calloc + memcpy is enough because replace_underlying_type
// overwrites the whole Type in place
deep_copy_type: proc(t: *Type) -> *Type {
    ret: *Type = calloc(1, sizeof(Type));
    memcpy(ret, t, sizeof(Type));
    match tt := t {
        Type_Builtin => {},
        Type_Pointer => {
            p: Type_Pointer = ret._1;
            p.inner = deep_copy_type(tt.inner);
            ret._1 = p;
        },
        Type_Proc => {
            new_args: [+]Variable_Decl_Node = array_new(Variable_Decl_Node);
            for i: i32 = 0; i < array_size(tt.args); i = i + 1 {
                tmp: Variable_Decl_Node = deep_copy_var_decl(&tt.args[i]);
                array_append(new_args, tmp);
            }
            p: Type_Proc = ret._2;
            p.args                 = new_args;
            p.default_vals         = tt.default_vals;
            p.attributes           = tt.attributes;
            p.generic_type_symbols = tt.generic_type_symbols;
            p.name                 = tt.name;
            p.new_name             = 0;
            p.is_generic           = false;
            if tt.return_type != 0 {
                p.return_type = deep_copy_type(tt.return_type);
            } else {
                p.return_type = 0;
            }
            if tt.block != 0 {
                p.block = deep_copy_block(tt.block);
            } else {
                p.block = 0;
            }
            ret._2 = p;
        },
        Type_Array => {
            a: Type_Array = ret._3;
            a.array_type = deep_copy_type(tt.array_type);
            ret._3 = a;
        },
        Type_Dynamic_Array => {
            a: Type_Dynamic_Array = ret._4;
            a.array_type = deep_copy_type(tt.array_type);
            ret._4 = a;
        },
        Type_Choice          => {},
        Type_Custom_Decl     => {},
        Type_Custom          => {},
        Type_Unknown         => {},
    }
    return ret;
}

// returns by value so it can be array_append'd into a fresh args array
deep_copy_var_decl: proc(v: *Variable_Decl_Node) -> Variable_Decl_Node {
    new_type: *Type = deep_copy_type(&v.var_type);
    ret: Variable_Decl_Node = Variable_Decl_Node{ v.symbol, v.rhs, new_type[0], v.is_arg };
    return ret;
}

// copies the Block_Node struct (scope + statements handle), then allocates a
// fresh statements array and shallow-copies each Statement. Statements hold
// pointers to Expression trees which we never mutate in place during SA or
// codegen, so sharing the expression subtrees is fine for now.
deep_copy_block: proc(b: *Block_Node) -> *Block_Node {
    ret: *Block_Node = calloc(1, sizeof(Block_Node));
    ret.scope = b.scope;
    ret.statements = array_new(Statement);
    for i: i32 = 0; i < array_size(b.statements); i = i + 1 {
        array_append(ret.statements, b.statements[i]);
    }
    return ret;
}

// derives the mangled name for a monomorphized generic proc instance based on
// the concrete types of the call site arguments
derive_generic_proc_name: proc(
    s: *State,
    base_name: string,
    args: [+]Variable_Decl_Node,
    generic_type_symbols: [+]*Token,
    call: *Call_Node
) -> string {
    sb: String_Builder;
    sb_push_str(&sb, base_name);
    for i: i32 = 0; i < array_size(args); i = i + 1 {
        arg: *Variable_Decl_Node = &args[i];
        arg_type: *Type = &arg.var_type;
        for j: i32 = 0; j < array_size(generic_type_symbols); j = j + 1 {
            type_symbol: *Token = generic_type_symbols[j];
            type_symbol_str: string = type_symbol.tok;
            ct: *Concrete_Type = find_underlying_type(arg_type);
            at_name: *Token;
            at_name_str: string;
            match t := ct {
                Type_Builtin => { todo("", #FILE, #LINE); },
                Type_Custom => {
                    at_name = t.name;
                    at_name_str = at_name.tok;
                }
            }
            if strcmp(at_name_str, type_symbol_str) {
                expr: *Expression = array_get(sizeof(Expression), call.args, i);
                expr_type: *Type = match_expression(s, expr);
                type_str: string = get_c_type(expr_type[0]);
                sb_push(&sb, '_');
                sb_push_str(&sb, type_symbol_str);
                sb_push(&sb, '_');
                sb_push_str(&sb, type_str);
            }
        }
    }
    ret: string = sb_to_string(&sb);
    sb_free(&sb);
    return ret;
}

substitute_generic_arg_types: proc(
    s: *State,
    args: [+]Variable_Decl_Node,
    generic_type_symbols: [+]*Token,
    call: *Call_Node
) {
    for i: i32 = 0; i < array_size(args); i = i + 1 {
        arg: *Variable_Decl_Node = &args[i];
        arg_type: *Type = &arg.var_type;
        for j: i32 = 0; j < array_size(generic_type_symbols); j = j + 1 {
            type_symbol: *Token = generic_type_symbols[j];
            type_symbol_str: string = type_symbol.tok;
            ct: *Concrete_Type = find_underlying_type(arg_type);
            at_name: *Token;
            at_name_str: string;
            match t := ct {
                Type_Builtin => { todo("", #FILE, #LINE); },
                Type_Custom => {
                    at_name = t.name;
                    at_name_str = at_name.tok;
                }
            }
            if strcmp(at_name_str, type_symbol_str) {
                expr: *Expression = array_get(sizeof(Expression), call.args, i);
                expr_type: *Type = match_expression(s, expr);
                replace_underlying_type(arg_type, expr_type);
            }
        }
    }
}

// this is for adding the typed procs for generics
create_new_typed_proc: proc(
    s: *State, 
    proc_decl: *Variable_Decl_Node, 
    proc_type: *Type_Proc, 
    call: *Call_Node
) -> *Variable_Decl_Node {
    ast: *Ast = s.ast;
    assert(proc_type.is_generic, "Can only supply generic functions here", #FILE, #LINE);
    proc_decl_type: *Type = &proc_decl.var_type;
    new_proc_decl: *Variable_Decl_Node = calloc(1, sizeof(Variable_Decl_Node));
    memcpy(new_proc_decl, proc_decl, sizeof(Variable_Decl_Node));
    new_proc_decl_type: *Type = &new_proc_decl.var_type;
    generic_type_symbols: [+]*Token;
    new_proc_type: *Type_Proc = 0;
    // we need to just copy the shit first
    match pt := proc_decl_type {
        Type_Pointer => { unreachable("", #FILE, #LINE); },
        Type_Builtin => { unreachable("", #FILE, #LINE); },
        Type_Proc => { 
            match new_pt := new_proc_decl_type {
                Type_Pointer => { unreachable("", #FILE, #LINE); },
                Type_Builtin => { unreachable("", #FILE, #LINE); },
                Type_Proc => { 
                    new_pt.is_generic = false;
                    generic_type_symbols = pt.generic_type_symbols; // shared, read-only

                    // fresh args array, each arg owns its var_type (incl. inner *Type)
                    new_pt.args = array_new(Variable_Decl_Node);
                    for i: i32 = 0; i < array_size(pt.args); i = i + 1 {
                        tmp: Variable_Decl_Node = deep_copy_var_decl(&pt.args[i]);
                        array_append(new_pt.args, tmp);
                    }

                    // fresh return type (deep, so generic symbols inside it can be substituted)
                    if pt.return_type != 0 {
                        new_pt.return_type = deep_copy_type(pt.return_type);
                    } else {
                        new_pt.return_type = 0;
                    }

                    // fresh block with its own statements buffer
                    if pt.block != 0 {
                        new_pt.block = deep_copy_block(pt.block);
                    } else {
                        new_pt.block = 0;
                    }

                    // fresh name token; caller will overwrite .tok with the mangled string
                    new_pt.new_name = calloc(1, sizeof(Token));
                    memcpy(new_pt.new_name, pt.name, sizeof(Token));

                    // shared, never mutated during instantiation — flagged as known alias
                    new_pt.attributes   = pt.attributes;
                    new_pt.default_vals = pt.default_vals;
                    new_pt.name         = pt.name;

                    new_proc_type = new_pt;

                },
                Type_Array => { unreachable("", #FILE, #LINE); },
                Type_Dynamic_Array => { unreachable("", #FILE, #LINE); },
                Type_Choice => { unreachable("", #FILE, #LINE); },
                Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
                Type_Custom => { unreachable("", #FILE, #LINE); },
                Type_Unknown => { unreachable("", #FILE, #LINE); },
            }
        },
        Type_Array => { unreachable("", #FILE, #LINE); },
        Type_Dynamic_Array => { unreachable("", #FILE, #LINE); },
        Type_Choice => { unreachable("", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
        Type_Custom => { unreachable("", #FILE, #LINE); },
        Type_Unknown => { unreachable("", #FILE, #LINE); },
    }

    // TODO: handle cases with default values
    assert(array_size(new_proc_type.default_vals) == 0, 
        "TODO: Need to sort out generics when the proc decl has default values", 
        #FILE, 
        #LINE);
    assert(new_proc_type != 0, "", #FILE, #LINE);
    
    new_name: *Token = new_proc_type.new_name;
    new_name.tok = derive_generic_proc_name(s, new_name.tok, new_proc_type.args, generic_type_symbols, call);
    substitute_generic_arg_types(s, new_proc_type.args, generic_type_symbols, call);
    new_proc_type.new_name = new_name;
    new_proc_decl.symbol = new_name;
    tmp: *Token = new_name.tok;
    printf("generic_proc: %s\n".ptr, tmp.ptr);

    todo("handle generic types", #FILE, #LINE);

    // declare new header for this proc
    // TODO: change the name
    new_proc_header: Proc_Header_Node = Proc_Header_Node{ new_proc_decl.symbol, new_proc_type.args, new_proc_type.return_type, new_proc_type.attributes };
    array_append(ast.procs, new_proc_header);
}

// kind of a dumb arg name but anyway
find_underlying_type: proc(big_type: *Type) -> *Concrete_Type {
    match t := big_type {
        Type_Pointer => { 
            ret: *Concrete_Type  = find_underlying_type(t.inner); 
            return ret;
        },
        Type_Builtin => { 
            ret: *Concrete_Type = calloc(1, sizeof(Concrete_Type));
            val: Type_Builtin = t[0];
            ret_tmp: Concrete_Type  = Concrete_Type{ val }; 
            memcpy(ret, &ret_tmp, sizeof(Concrete_Type));
            return ret;
        },
        Type_Proc => {},
        Type_Array => { 
            ret: *Concrete_Type  = find_underlying_type(t.array_type); 
            return ret;
        },
        Type_Dynamic_Array => { 
            ret: *Concrete_Type  = find_underlying_type(t.array_type); 
            return ret;
        },
        Type_Choice => { unreachable("", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
        Type_Custom => { 
            ret: *Concrete_Type = calloc(1, sizeof(Concrete_Type));
            val: Type_Custom = t[0];
            ret_tmp: Concrete_Type = Concrete_Type{ val }; 
            memcpy(ret, &ret_tmp, sizeof(Concrete_Type));
            return ret;
        },
        Type_Unknown => { unreachable("", #FILE, #LINE); },
    }
}

// replace t1 with t2
replace_underlying_type: proc(t1: *Type, t2: *Type) {
    both_dyn_array: bool = false;
    t2_dyn_arry_inner: *Type;
    // NOTE: this is just for dynamic arrays
    match t := t2 {
        Type_Pointer => {},
        Type_Builtin => {},
        Type_Proc => {},
        Type_Array => {},
        Type_Dynamic_Array => { 
            both_dyn_array = true;
            t2_dyn_arry_inner = t.array_type;
        },
        Type_Choice => { unreachable("", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
        Type_Custom => {},
        Type_Unknown => { unreachable("", #FILE, #LINE); },
    }

    match t := t1 {
        Type_Pointer => { 
            replace_underlying_type(t.inner, t2); 
        },
        Type_Builtin => { 
            // TODO: not sure if memcpy works, delete comment if yes
            memcpy(t1, t2, sizeof(Type));
        },
        Type_Proc => {},
        Type_Array => { 
            replace_underlying_type(t.array_type, t2); 
        },
        Type_Dynamic_Array => { 
            if both_dyn_array {
                replace_underlying_type(t.array_type, t2_dyn_arry_inner); 
            } else {
                replace_underlying_type(t.array_type, t2); 
            }
        },
        Type_Choice => { unreachable("", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
        Type_Custom => { 
            // TODO: not sure if memcpy works, delete comment if yes
            memcpy(t1, t2, sizeof(Type));
        },
        Type_Unknown => { unreachable("", #FILE, #LINE); },
    }
}

handle_generic_procs: proc(s: *State, proc_decl: *Variable_Decl_Node, call: *Call_Node) -> bool {
    // TODO: also will need to append a bunch of Proc_Header_Nodes for the generic procs
    // TODO: might need to return proc return type(?)
    proc_type: *Type = &proc_decl.var_type;
    ast: *Ast = s.ast;
    scopes: [+]Scope = ast.scopes;
    procs: [+]Proc_Header_Node = ast.procs;

    match pt := proc_type {
        Type_Pointer => { unreachable("", #FILE, #LINE); },
        Type_Builtin => { unreachable("", #FILE, #LINE); },
        Type_Proc => { 
            if pt.is_generic {
                // create new generic types
                // TODO: handle return value
                create_new_typed_proc(s, proc_decl, pt, call);
                todo("generic procs in sa", #FILE, #LINE);
            }
            return pt.is_generic;
        },
        Type_Array => { unreachable("", #FILE, #LINE); },
        Type_Dynamic_Array => { unreachable("", #FILE, #LINE); },
        Type_Choice => { unreachable("", #FILE, #LINE); },
        Type_Custom_Decl => { unreachable("", #FILE, #LINE); },
        Type_Custom => { unreachable("", #FILE, #LINE); },
        Type_Unknown => { unreachable("", #FILE, #LINE); },
    }
    unreachable("Should not be called with non Proc types", #FILE, #LINE);
}

match_expression: proc(s: *State, _expr: *Expression) -> *Type {
    // TODO/NOTE: Have to do this because of bug
    expr: *Expression = _expr;
    ast: *Ast = s.ast;
    match e := expr {
        Binary_Node => { 
            // TODO: implement this please
            // todo("", #FILE, #LINE);
            // lhs_type: *Type = match_expression(s, e.lhs);
            // rhs_type: *Type = match_expression(s, e.rhs);
            // res: bool = check_types(lhs_type, rhs_type);
            // handling the ptr deref for member access
            lhs_type: *Type = match_expression(s, e.lhs);
            if e.op == OP_ACCESS && lhs_type != 0 {
                match bt := lhs_type {
                    Type_Pointer => { e.needs_ptr_deref = true; },
                    Type_Builtin => {},
                    Type_Proc => {},
                    Type_Array => {},
                    Type_Dynamic_Array => {},
                    Type_Choice => {},
                    Type_Custom_Decl => {},
                    Type_Custom => {},
                    Type_Unknown => {},
                }
            }
            match_expression(s, e.rhs);
            return 0;
        },
        Number_Node => { 
            // todo("", #FILE, #LINE);
            return create_type_builtin(TYPE_I64);
        },
        Variable_Node => { 
            // lookup var_decl to check the type
            name_tok: *Token = e.symbol;
            name: string = name_tok.tok;
            var_decl: *Variable_Decl_Node = lookup_name(ast.scopes, ast.current_scope, name);
            if var_decl == 0 {
                return 0;
            }
            return &var_decl.var_type;
        },
        Call_Node => { 
            // lookup proc var_decl to check the return type
            name_tok: *Token = e.name;
            name: string = name_tok.tok;
            var_decl: *Variable_Decl_Node = lookup_name(ast.scopes, ast.current_scope, name);
            builtin: *Type = get_builtin_proc_type(name);
            if builtin != 0 {
                // need to walkthrough all the args
                for i: i32 = 0; i < array_size(e.args); i = i + 1 {
                    expr: *Expression = &e.args[i];
                    match_expression(s, expr);
                }
                return builtin;
            }
            if var_decl == 0 {
                printf("%s\n".ptr, name.ptr);
                panic("Could not find proc (lookup_name)\n", #FILE, #LINE);
            }
            is_generic: bool = handle_generic_procs(s, var_decl, e);
            if is_generic {
                // todo("handle the generic call", #FILE, #LINE);
            }
            ret_type: *Type = get_proc_return_type(var_decl);

            // TODO: check if the default values are at the end because skipping is not allowed
            //       or should it be allowed?
            proc_args: [+]Variable_Decl_Node = get_proc_args(var_decl);
            proc_args_len: i32 = array_size(proc_args);
            call_args_len: i32 = array_size(e.args);
            default_vals: [+]Expression = get_proc_default_values(var_decl);
            default_vals_len: i32 = array_size(default_vals);
            provided_args: i32 = proc_args_len - call_args_len;

            if provided_args > 0 {
                // need to provide default args
                if (default_vals_len + call_args_len) < proc_args_len {
                    compile_error(name_tok, "Too few arguments provided in this function call");
                } else {
                    for i: i32 = 0; i < default_vals_len; i = i + 1 {
                        array_append(e.args, default_vals[i]);
                    }
                }
            } else if provided_args < 0 {
                compile_error(name_tok, "Too many arguments provided in this function call");
            }

            // need to insert the default values if required
            for i: i32 = 0; i < array_size(default_vals); i = i + 1 {
                d: *Expression = &default_vals[i];
            }

            // need to walkthrough all the args
            for i: i32 = 0; i < array_size(e.args); i = i + 1 {
                expr: *Expression = &e.args[i];
                match_expression(s, expr);
            }

            return ret_type;
        },
        String_Literal => { 
            return create_type_builtin(TYPE_STRING);
        },
        Unary_Node => { 
            if e.op == OP_REFERENCE {
                inner_type: *Type = match_expression(s, e.base);
                return create_type_pointer(inner_type);
            }
            return match_expression(s, e.base);
        },
        Struct_Init_Node => { 
            type_def: *Type = lookup_type(s, e.name);
            if type_def == 0 {
                unknown_type_name_error(e.name);
            }
            match t := type_def {
                Type_Builtin => {},
                Type_Pointer => {},
                Type_Proc => {},
                Type_Array => {},
                Type_Dynamic_Array => {},
                Type_Choice => {
                    // We need to construct
                    e.is_choice = true;
                    determine_choice_tags(s, e, t);
                },
                Type_Custom_Decl => {
                    // We do nothing in this case because
                    // codegen will correctly spit this out 
                    // TODO: make the error messages better, more detailed etc
                    assert(array_size(e.exprs) == array_size(t.fields), 
                        "struct initializer must match the number of fields in the struct definition", 
                        #FILE, 
                        #LINE
                    );
                },
                Type_Custom => {},
                Type_Unknown => {},
            }
            ret: *Type = construct_type_custom(e.name); 
            return ret;
            //todo("", #FILE, #LINE);
        },
        Array_Literal => { 
            // NOTE: this is done in the var declaration instead
            // elements: [+]Expression = e.elements;
            // for i: i32 = 0; i < array_size(elements); i = i + 1 {
            //     expr: *Expression = &elements[i];
            //     match_expression(s, expr);
            // }
        },
    } 
}

