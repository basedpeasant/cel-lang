
write: @extern proc(fd: i32, buf: *u8, count: i32) -> i32;
exit: @extern proc(code: i32);

abort: @extern proc();
//calloc: @extern proc(n: u64, size: u64) -> void_ptr;
realloc: @extern proc(ptr: void_ptr, size: u64) -> void_ptr;
free: @extern proc(ptr: void_ptr);
memset: @extern proc(ptr: void_ptr, c: i32, n: u64) -> void_ptr;
read: @extern proc(fd: i32, buf: void_ptr, count: u32) -> i32;
open: @extern proc(pathname: *u8, flags: i32, mode: u32) -> i32;
close: @extern proc(fd: i32) -> i32;
memcpy: @extern proc(dest: void_ptr, src: void_ptr, n: u32) -> void_ptr;
memmove: @extern proc(dest: void_ptr, src: void_ptr, n: u32) -> void_ptr;
strlen: @extern proc(s: *u8) -> i32;
fork: @extern proc() -> i32;
execvp: @extern proc(file: *u8, argv: **u8) -> i32;
wait3: @extern proc(wstatus: *i32, options: i32, rusage: void_ptr) -> i32;
wait4: @extern proc(pid: i32, wstatus: *i32, options: i32, rusage: void_ptr) -> i32;


O_RDONLY: i32 = 0;
O_WRONLY: i32 = 1;
O_CREAT: i32 = 64;
O_TRUNC: i32 = 512;

string: type struct {
	length: u32,
	ptr: *u8
}

unreachable: proc(msg: string, file: string, line: u32) {
    //NOTE: this __FILE__ and __LINE__ don't make sense here
	printf("%s:%d: UNREACHABLE: %s\n".ptr, file.ptr, line, msg.ptr);
	exit(101);
}

todo: proc(msg: string, file: string, line: u32) {
	//NOTE: this __FILE__ and __LINE__ don't make sense here
	printf("%s:%d: TODO: %s\n".ptr, file.ptr, line, msg.ptr);
	exit(101);
}

panic: proc(msg: string, file: string, line: u32) {
	//NOTE: this __FILE__ and __LINE__ don't make sense here
	printf("%s:%d: panic: %s\n".ptr, file.ptr, line, msg.ptr);
	exit(101);
}

assert: proc(condition: bool, msg: string, file: string, line: u32) {
    // TODO: print assertion condition maybe?
    if !condition {
        printf("%s:%d: assertion failed: %s\n".ptr, file.ptr, line, msg.ptr);
        exit(101);
    }
}

is_valid_utf8: proc(s: string) -> bool {
    len: i32 = s.length;

    for i: i32 = 0; i < len; i {
        c: u8 = s.ptr[i];
        if c < 0x80 {
            i = i + 1;
            continue;
        }

        // 2-byte range: 0xc0 .. 0xdf
        if c >= 0xc0 {
            if c <= 0xdf {
                tmp_next: i32 = i + 1;
                if tmp_next >= len {
                    return false;
                }
                cont: u8 = s.ptr[tmp_next] & 0xc0;
                if cont != 0x80 {
                    return false;
                }
                // overlong check still needs & (unavoidable)
                over: u8 = c & 0xfe;
                if over == 0xc0 {
                    return false;
                }
                i = tmp_next + 1;  // = i + 2
                continue;
            }
        }

        // 3-byte range: 0xe0 .. return 0xef;
        if c >= 0xe0 {
            if c <= 0xef {
                tmp_next: i32 = i + 2;
                if tmp_next >= len {
                    return false;
                }
                cont1: u8 = s.ptr[i + 1] & 0xc0;
                if cont1 != 0x80 {
                    return false;
                }
                cont2: u8 = s.ptr[i + 2] & 0xc0;
                if cont2 != 0x80 {
                    return false;
                }
                // overlong / surrogate checks still need some &
                // (you may have to keep them or find another way)
                i = tmp_next + 1;  // i + 3
                continue;
            }
        }

        // 4-byte range: 0xf0 .. 0xf7
        if c >= 0xf0 {
            if c <= 0xf7 {
                tmp_next: i32 = i + 3;
                if tmp_next >= len {
                    return false;
                }
                cont1: u8 = s.ptr[i + 1] & 0xc0;
                if cont1 != 0x80 {
                    return false;
                }
                cont2: u8 = s.ptr[i + 2] & 0xc0;
                if cont2 != 0x80 {
                    return false;
                }
                cont3: u8 = s.ptr[i + 3] & 0xc0;
                if cont3 != 0x80 {
                    return false;
                }
                // overlong / >10FFFF checks
                i = tmp_next + 1;  // i + 4
                continue;
            }
        }

        return false;
    }

    return true;
}

read_file_to_string: proc(filename: string) -> string {
	sb: String_Builder;
	fd: i32 = open(filename.ptr, O_RDONLY, 0);
    // NOTE: we would do fd == -1 but we don't support negative numbers rn lol
    if fd < 0 {
        printf("Could not open the file '%s'\n".ptr, filename.ptr);
        panic("", #FILE, #LINE);
    }
	c: [1]u8;
	len: i32 = 0;
	bytes_read: i32 = read(fd, &c, sizeof(c));
	if bytes_read > 0 {
		sb_push(&sb, c[0]);
		len = len + 1;
	}
	for bytes_read > 0 {
		bytes_read = read(fd, &c, sizeof(c));
		sb_push(&sb, c[0]);
		len = len + 1;
	}
	ret: string = string{ len, sb.chars };
	close(fd);
	return ret;
}

write_string_to_file: proc(content: string, filename: string) {
    // NOTE: 420 = 0644, currently language doesn't support Octal numbers
    fd: i32 = open(filename.ptr, O_WRONLY | O_CREAT | O_TRUNC, 420);
    write(fd, content.ptr, content.length);
    close(fd);
}

write_string_builder_to_file: proc(sb: *String_Builder, filename: string) {
    if sb.chars[sb.length - 1] != 0 {
        sb_push(sb, 0);
    }
    tmp_str: string = string{ sb.length - 1, sb.chars };
    write_string_to_file(tmp_str, filename);
}

fgetc: proc(fd: i32) -> u8 {
	c: [1]u8;
	bytes_read: i32 = read(fd, &c, sizeof(c));
	if bytes_read > 0 {
		return c[0];
	} else {
		return 0;
	}
}

putc: proc(c: u8) {
	buf: [1]u8 = [c];
	write(1, buf, 1);
}

SB_INITIAL_CAPACITY: u32 = 10;

String_Builder: type struct {
    length: u32,
    capacity: u32,
    chars: *u8
}

sb_push: proc(sb: *String_Builder, c: u8) {
    if sb.length + 1 >= sb.capacity {
        new_capacity: u32;
        if sb.capacity == 0 {
            new_capacity = SB_INITIAL_CAPACITY;
        } else {
            new_capacity = sb.capacity * 2;
        }
        p: *u8 = realloc(sb.chars, new_capacity * sizeof(char));
        if p == 0 {
            printf("Allocation failed\n".ptr);
            exit(1);
        }
        memset(p + sb.length, 0, sb.capacity);
        sb.chars = p;
        sb.capacity = new_capacity;
    }
    sb.chars[sb.length] = c;
    sb.chars[sb.length + 1] = 0;
    sb.length = sb.length + 1;
}

sb_push_str: proc(sb: *String_Builder, str: string) {
    for i: i32 = 0; i < str.length; i = i + 1 {
        if str.ptr[i] == 0 {
            break;
        }
        sb_push(sb, str.ptr[i]);
    }
}

sb_to_string: proc(sb: *String_Builder) -> string {
	ptr: *u8;
    ptr = calloc(sb.length + 1, sizeof(char));
    for i: i32 = 0; i < sb.length; i = i + 1 {
        ptr[i] = sb.chars[i];
	}
    ptr[sb.length] = 0;
    ret : string = string{ sb.length, ptr };
	return ret;
}

sb_clear: proc(sb: *String_Builder) {
	sb.length = 0;
}

sb_free: proc(sb: *String_Builder) {
	sb.length = 0;
	sb.chars = 0;
	sb.capacity = 0;
	free(sb.chars);
}

strcmp: proc(a: string, b: string) -> bool {
	if a.length != b.length {
		return false;
	}
	
	for i: i32 = 0; i < a. length; i = i + 1 {
		if a.ptr[i] != b.ptr[i] {
			return false;
		}
	}
	return true;
}

string_copy: proc(str: string) -> string {
    ret_ptr: *u8 = calloc(str.length, sizeof(char));
    memcpy(ret_ptr, str.ptr, str.length);
    ret: string = string{ str.length, ret_ptr };
    return ret;
}

run_process: proc(name: string, args: **u8) -> i32 {
    // TODO: this procedure needs some serious work lol, but anyway this works for my current
    //       needs
    pid: i32 = fork(0);
    if pid == 0 {
        execvp("cc".ptr, args);
    }
    status: i32;
    ret: i32 = wait4(pid, &status, 0, 0); // blocking
    return status;
}


