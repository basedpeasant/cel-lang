pow: proc(base: i64, exponent: i64) -> i64 {
    if exponent < 0 {
        panic("Language doesn't support negative numbers yet lol", #FILE, #LINE);
    }
    num: i64 = 1;
    for i: i32 = 0; i < exponent; i = i + 1 {
        num = base * num;
    }
    return num;
}

// utility to convert string to i64
// NOTE: this proc assumes that the string is a known integer
// ALSO might not be correct for all text types
strtoi: proc(str: string) -> i64 {
    
    if str.length > 2 && str.ptr[0] == '0' && str.ptr[1] == 'x' {
        // hex number 
        num: i64 = 0;
        base: i32 = 16;
        for i: i32 = str.length - 1; i > 1; i = i - 1 {
            c: u8 = str.ptr[i];

            c_num: i64;
            if c >= 48 && c <= 57 {
                c_num = c - 48;
            } else if c >= 65 && c <= 70 {
                c_num = c - 55;
            } else if c >= 97 && c <= 102 {
                c_num = c - 87;
            } else {
                printf("%c\n".ptr, c);
                unreachable("Should not be here because this should get caught in tokenization", #FILE, #LINE);
            }
            num = num + (c_num * pow(base, str.length - i + 1));
        }
        return num;
    } else {
        // decimal number
        num: i64 = 0;
        base: i32 = 1;
        for i: i32 = str.length - 1; i >= 0; i = i - 1 {
            c: u8 = str.ptr[i];

            c_num: i64 = c - 48;
            if c_num < 0 || c_num > 9 {
                printf("%zu\n".ptr, c);
                panic("invalid digit during strtoi", #FILE, #LINE);
            }

            num = c_num * base + num;
            base = base * 10;
        }
        return num;
    }
}

validate_char: proc(t: *Token) -> u64 {
    char_str: string = t.tok;
    // TODO: need to specify where
    // TODO: make this error better
    assert(char_str.length <= 2, "Invalid character length", #FILE, #LINE);
    if char_str.length == 2 {
        if char_str.ptr[0] == '\\' {
            c1: u8 = char_str.ptr[1];
            if c1 == '0' {
                return 0;
            } else if c1 == 't' {
                return 9;
            } else if c1 == 'n' {
                return 10;
            } else if c1 == 'r' {
                return 13;
            } else if c1 == '\\' {
                return 92;
            } else if c1 == '\'' {
                return 39;
            } else {
                printf("Unrecognized escape: '\\%c'\n".ptr, c1);
                todo("Unrecognized escape sequence", #FILE, #LINE);
            }
        } else {
            printf("Unrecognized character: '%s'\n".ptr, char_str.ptr);
            todo("Unrecognized escape sequence", #FILE, #LINE);
        }
    } else {
        return char_str.ptr[0];
    }
}

parse_primary: proc(ast: *Ast, scope: u32, in_if: bool) -> Expression {
    current_token: *Token = get_current_token(ast); 
    if current_token.tt == TK_NUMBER {
        num: Number_Node = Number_Node{ strtoi(current_token.tok) };
        ret: Expression = Expression{ num };
        advance(ast);
        return ret;
    } else if current_token.tt == TK_SINGLE_QUOTE {
        val: u64 = validate_char(current_token);
        num: Number_Node = Number_Node{ val };
        ret: Expression = Expression{ num };
        advance(ast);
        return ret;
    } else if current_token.tt == TK_WORD {
        peek: *Token = get_peek(ast);
        if peek.tt == TK_OPEN_PAREN {
            name: *Token = current_token;
            advance(ast);
            advance(ast);
            args: [+]Expression;
            for true {
                current_token: *Token = get_current_token(ast);
                if current_token.tt == TK_CLOSE_PAREN {
                    break;
                }
                arg: Expression = ast_create_expr(ast, scope, false); 
                array_append(args, arg);
                current_token = get_current_token(ast);
                if current_token.tt == TK_CLOSE_PAREN {
                    break;
                } else if current_token.tt == TK_COMMA {
                    advance(ast);
                }
            }
            ast_match(ast, TK_CLOSE_PAREN, #FILE, #LINE);
            advance(ast);
            call: Call_Node = Call_Node{ name, args };
            ret: Expression = Expression{ call };
            return ret;
        } else if peek.tt == TK_OPEN_CURLY && !in_if {
            // make sure that the program doesn't mistake an if statement and a opencurly
            // as struct initialization list hence why in_if is needed
            // struct initialization list 
            name: *Token = current_token;
            advance(ast); // name
            advance(ast); // opencurly
            current_token = get_current_token(ast);
            custom: Struct_Init_Node = Struct_Init_Node{ name, array_new(Expression), false, 0 };
            for current_token.tt != TK_CLOSE_CURLY {
                value: Expression = ast_create_expr(ast, scope, false);
                current_token = get_current_token(ast);
                array_append(custom.exprs, value);
                if current_token.tt == TK_COMMA {
                    advance(ast);
                }
            }
            advance(ast);
            ret: Expression = Expression{ custom };
            return ret;
        } else if peek.tt == TK_OPEN_SQUARE {
            variable: Variable_Node = Variable_Node{ get_current_token(ast) };
            base_tmp: Expression = Expression { variable };
            base_alloc: *Expression = calloc(1, sizeof(Expression));
            memcpy(base_alloc, &base_tmp, sizeof(Expression));
            expr_alloc: *Expression = calloc(1, sizeof(Expression));
            op: i32 = get_op(peek); // note: I guess doesn't need to be a function call but anyway
            advance(ast);
            ast_match(ast, TK_OPEN_SQUARE, #FILE, #LINE);
            advance(ast);
            expr: Expression = ast_create_expr(ast, scope, in_if);
            ast_match(ast, TK_CLOSE_SQUARE, #FILE, #LINE);
            advance(ast);
            memcpy(expr_alloc, &expr, sizeof(Expression));
            expr_alloc._tag = get_expr_tag(&expr);
            tmp_str: string = current_token.tok;
            unary: Unary_Node = Unary_Node{ op, base_alloc, expr_alloc }; 
            ret: Expression = Expression{ unary };
            return ret;
        } else {
            // variables
            print_token(get_current_token(ast));
            variable: Variable_Node = Variable_Node{ get_current_token(ast) };
            ret: Expression = Expression{ variable };
            advance(ast);
            tok: *Token = get_current_token(ast);
            return ret;
        }
    } else if current_token.tt == TK_DOUBLE_QUOTE {
        string_literal: String_Literal = String_Literal{ current_token.tok, ast.strings_index };
        array_append(ast.strings, string_literal);
        ret: Expression = Expression{ string_literal };
        ast.strings_index = ast.strings_index + 1;
        advance(ast);
        return ret;
    } else if current_token.tt == TK_OPEN_PAREN {
        advance(ast) ;
        expr: Expression = ast_create_expr(ast, scope, false);
        ast_match(ast, TK_CLOSE_PAREN, #FILE, #LINE);
        advance(ast);
        //TODO: handle postfix operators for bracketed expressions as well when implemented
        return expr;
    } else if current_token.tt == TK_TILDE     || 
              current_token.tt == TK_AMPERSAND || 
              current_token.tt == TK_NOT 
    {
        base_alloc: *Expression = calloc(1, sizeof(Expression));
        op: i32 = get_op(current_token);
        advance(ast);
        expr: Expression = parse_primary(ast, scope, in_if);
        memcpy(base_alloc, &expr, sizeof(Expression));
        base_alloc._tag = get_expr_tag(&expr);
        tmp_str: string = current_token.tok;
        unary: Unary_Node = Unary_Node{ op, base_alloc, 0 }; 
        ret: Expression = Expression{ unary };
        return ret;
    } else if current_token.tt == TK_OPEN_SQUARE {
        // array literal
        ast_match(ast, TK_OPEN_SQUARE, #FILE, #LINE);
        advance(ast);
        array_lit: Array_Literal;
        array_lit.elements = array_new(Expression);
        current_token: *Token = get_current_token(ast);
        for true {
            if current_token.tt == TK_CLOSE_SQUARE {
                break;
            } else if current_token.tt == TK_COMMA {
                advance(ast);
            }
            element: Expression = ast_create_expr(ast, scope, false);
            array_append(array_lit.elements, element);
            current_token = get_current_token(ast);
        }
        ast_match(ast, TK_CLOSE_SQUARE, #FILE, #LINE);
        advance(ast);
        ret: Expression = Expression{ array_lit };
        return ret;
    } else {
        compile_error(current_token, "(Parse Primary) Unexpected Token");
    }
}

get_op_string: proc(op: i32) -> string {
    if op == OP_ADD {
        return "+";
    } else if op == OP_SUB {
        return "-";
    } else if op == OP_MUL {
        return "*";
    } else if op == OP_DIV {
        return "/";
    } else if op == OP_OR {
        return "|";
    } else if op == OP_LOGICAL_OR {
        return "||";
    } else if op == OP_LOGICAL_AND {
        return "&&";
    } else if op == OP_GT {
        return ">";
    } else if op == OP_GTE {
        return ">=";
    } else if op == OP_LT {
        return "<";
    } else if op == OP_LTE {
        return "<=";
    } else if op == OP_EQUAL {
        return "==";
    } else if op == OP_NOT_EQUAL {
        return "!=";
    } else if op == OP_REFERENCE {
        return "&";
    } else if op == OP_ASSIGN {
        return "=";
    } else if op == OP_ARRAY_INDEX {
        return "[]";
    } else if op == OP_ACCESS {
        return ".";
    } else if op == OP_NOT {
        return "!";
    } else if op == OP_AND {
        return "&";
    } else if op == OP_LEFT_SHIFT {
        return "<<";
    } else if op == OP_RIGHT_SHIFT {
        return ">>";
    } else if op == OP_BITWISE_XOR {
        return "^";
    } else if op == OP_BITWISE_NOT {
        return "~";
    } else if op == OP_ADD_ASSIGN {
        return "+=";
    } else if op == OP_SUB_ASSIGN {
        return "-=";
    } else if op == OP_DEREF {
        return ".*";
    } else if op == OP_MOD {
        return "%";
    } else {
        todo("print for get_op_string", #FILE, #LINE);
    }
}

// NOTE: this is because we don't have negative numbers
PREC_SENTINEL: i32 = 1024;

get_op: proc(token: *Token) -> i32 {
    if token.tt == TK_PLUS {
        return OP_ADD;
    } else if token.tt == TK_SUB {
        return OP_SUB;
    } else if token.tt == TK_STAR {
        return OP_MUL;
    } else if token.tt == TK_SLASH {
        return OP_DIV;
    } else if token.tt == TK_OR {
        return OP_OR;
    } else if token.tt == TK_LOGICAL_OR {
        return OP_LOGICAL_OR;
    } else if token.tt == TK_LOGICAL_AND {
        return OP_LOGICAL_AND;
    } else if token.tt == TK_GT {
        return OP_GT;
    } else if token.tt == TK_GTE {
        return OP_GTE;
    } else if token.tt == TK_LT {
        return OP_LT;
    } else if token.tt == TK_LTE {
        return OP_LTE;
    } else if token.tt == TK_EQUAL {
        return OP_EQUAL;
    } else if token.tt == TK_NOT_EQUAL {
        return OP_NOT_EQUAL;
    } else if token.tt == TK_AMPERSAND {
        return OP_REFERENCE;
    } else if token.tt == TK_ASSIGN {
        return OP_ASSIGN;
    } else if token.tt == TK_OPEN_SQUARE {
        return OP_ARRAY_INDEX;
    } else if token.tt == TK_DOT {
        return OP_ACCESS;
    } else if token.tt == TK_NOT {
        return OP_NOT;
    } else if token.tt == TK_LEFT_SHIFT {
        return OP_LEFT_SHIFT;
    } else if token.tt == TK_RIGHT_SHIFT {
        return OP_RIGHT_SHIFT;
    } else if token.tt == TK_HAT {
        return OP_BITWISE_XOR;
    } else if token.tt == TK_TILDE {
        return OP_BITWISE_NOT;
    } else if token.tt == TK_ADD_ASSIGN {
        return OP_ADD_ASSIGN;
    } else if token.tt == TK_SUB_ASSIGN {
        return OP_SUB_ASSIGN;
    } else if token.tt == TK_DEREF {
        return OP_DEREF;
    } else if token.tt == TK_PERCENT {
        return OP_MOD;
    } else {
        str: string = token.tok;
        printf("%s\n".ptr, str.ptr);
        panic("Unknown Operator", #FILE, #LINE);
    }
}

get_prec: proc(ast: *Ast, token: *Token) -> i32 {
    // TODO: other ops
    if token.tt == TK_OPEN_SQUARE || token.tt == TK_DOT {
        return 14;
    } else if token.tt == TK_DEREF || token.tt == TK_AMPERSAND {
        return 13;
    } else if token.tt == TK_TILDE {
        return 12;
    } else if token.tt == TK_STAR || token.tt == TK_SLASH || token.tt == TK_PERCENT {
        return 11;
    } else if token.tt == TK_PLUS || token.tt == TK_SUB {
        return 10;
    } else if token.tt == TK_LEFT_SHIFT || token.tt == TK_RIGHT_SHIFT {
        return 9;
    } else if token.tt == TK_GT || token.tt == TK_GTE {
        return 8;
    } else if token.tt == TK_LT || token.tt == TK_LTE {
        return 8;
    } else if token.tt == TK_EQUAL || token.tt == TK_NOT_EQUAL {
        return 7;
    } else if token.tt == TK_HAT {
        return 6;
    } else if token.tt == TK_OR {
        return 5;
    } else if token.tt == TK_LOGICAL_AND {
        return 4;
    } else if token.tt == TK_LOGICAL_OR {
        return 3;
    } else if token.tt == TK_ASSIGN     || 
              token.tt == TK_ADD_ASSIGN || 
              token.tt == TK_SUB_ASSIGN 
    {
        return 2;
    } else if token.tt == TK_SEMICOLON    || 
              token.tt == TK_COMMA        ||
              token.tt == TK_CLOSE_PAREN  ||
              token.tt == TK_CLOSE_SQUARE ||
              token.tt == TK_OPEN_CURLY   ||
              token.tt == TK_CLOSE_CURLY  
    {
        return PREC_SENTINEL; 
    } else {
        str: string = token.tok;
        printf("Unknown Operator '%s'\n".ptr, str.ptr);
        panic("", #FILE, #LINE);
    }
}

// NOTE/TODO: THIS IS EXTREMELY HACKY AND MUST BE CHANGED AS SOON AS BETTER DX FOR CHOICES APPEAR
// NOTE: ORDER MUST NOT CHANGE
get_expr_tag: proc(expr_: *Expression) -> i32 {
    expr: *Expression = expr_;
    match _e := expr {
        Binary_Node => {
            return 0;
        },
        Number_Node => {
            return 1;
        },
        Variable_Node => {
            return 2;
        },
        Call_Node => {
            return 3;
        },
        String_Literal => {
            return 4;
        },
        Unary_Node => {
            return 5;
        },
        Struct_Init_Node => {
            return 6;
        },
        Array_Literal => {
            return 7;
        }
    }
}

ast_create_binary: proc(op: i32, lhs: Expression, rhs: Expression) -> Binary_Node {
    lhs_alloc: *Expression = calloc(1, sizeof(Expression));
    rhs_alloc: *Expression = calloc(1, sizeof(Expression));
    memcpy(lhs_alloc, &lhs, sizeof(Expression));
    memcpy(rhs_alloc, &rhs, sizeof(Expression));
    lhs_alloc._tag = get_expr_tag(&lhs);
    rhs_alloc._tag = get_expr_tag(&rhs);
    ret: Binary_Node = Binary_Node{op, lhs_alloc, rhs_alloc};
    return ret;
}

ast_create_expr_with_prec: proc(ast: *Ast, min_prec: i32, scope: u32, in_if: bool) -> Expression {
    lhs: Expression = parse_primary(ast, scope, in_if);
    // TODO: parse_porstfix
    for true {
        op_token: *Token = get_current_token(ast);
        if op_token == 0 {
            break;
        }
        // NOTE: not sure if this is ok but should work for now.
        if op_token.tt == TK_DEREF {
            //construct a Unary node and wrap lhs with it
            base_alloc: *Expression = calloc(1, sizeof(Expression));
            op: i32 = get_op(op_token);
            memcpy(base_alloc, &lhs, sizeof(Expression));
            base_alloc._tag = get_expr_tag(&lhs);
            unary: Unary_Node = Unary_Node{ op, base_alloc, 0 };
            lhs_new: Expression = Expression{ unary };
            lhs = lhs_new;
            advance(ast);
            op_token = get_current_token(ast);
        }
        prec: i32 = get_prec(ast, op_token);

        // NOTE: this is because we don't have negative numbers lol
        if prec == PREC_SENTINEL || prec < min_prec {
            break;
        }

        // TODO: check if this actually succeeded
        advance(ast);
        // if success { // TODO: something like this
        //     return lhs
        // }

        rhs: Expression = ast_create_expr_with_prec(ast, prec, scope, in_if);
   
        bin: Binary_Node = ast_create_binary(get_op(op_token), lhs, rhs);
        tmp: Expression = Expression {bin};
        lhs = tmp;

        // TODO : parse_postfix
    }
    return lhs;
}

ast_create_expr: proc(ast: *Ast, scope: u32, in_if: bool) -> Expression {
    return ast_create_expr_with_prec(ast, 0, scope, in_if);
}

ast_create_for: proc(ast: *Ast, scope: u32) -> For_Node {
    ast_match(ast, TK_FOR, #FILE, #LINE);
    advance(ast);

    // TODO: account for other types of for loops
    peek: *Token = get_peek(ast);
    is_classic_for: bool = false;
    expr: *Expression = 0;
    init: *Statement = 0; // TODO: figure out how to get this to work lol
    post: *Expression = 0;
    for_scope: u32 = scope;

    current_token: *Token = get_current_token(ast);
    if current_token.tt == TK_OPEN_CURLY {
        // forever loop
        advance(ast);
        block: Block_Node = create_block(ast, false, scope);
        for_node: For_Node = For_Node{ block, is_classic_for, init, expr, post };
        return for_node;
    }

    if peek.tt == TK_COLON {
        // classical for loop 
        // TODO: this won't allow for empty conditions in the classic for 
        for_scope = create_new_scope(ast, for_scope);
        init = create_statement(ast, for_scope);
        ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
        advance(ast);

        expr_tmp: Expression = ast_create_expr(ast, scope, true);
        expr = calloc(1, sizeof(Expression));
        memcpy(expr, &expr_tmp, sizeof(Expression));
        ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
        advance(ast);

        post_tmp: Expression = ast_create_expr(ast, scope, true);
        post = calloc(1, sizeof(Expression));
        memcpy(post, &post_tmp, sizeof(Expression));
        is_classic_for = true;
    } else {
        // while for loops
        expr_tmp: Expression = ast_create_expr(ast, scope, true);
        expr = calloc(1, sizeof(Expression));
        memcpy(expr, &expr_tmp, sizeof(Expression));
    }
    ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
    advance(ast);

    block: Block_Node = create_block(ast, false, for_scope);
    for_node: For_Node = For_Node{ block, is_classic_for, init, expr, post };
    return for_node;
}

ast_create_if: proc(ast: *Ast, scope: u32) -> If_Node {
    skip_condition: bool = false;
    is_else: bool = false;
    current_token: *Token = get_current_token(ast);
    peek: *Token = get_peek(ast);

    //TODO/NOTE: would be cool allowing else to have one statement without the curly braces
    if current_token.tt == TK_IF {
        advance(ast);
    } else if current_token.tt == TK_ELSE && peek.tt == TK_OPEN_CURLY {
        // first if
        skip_condition = true; 
        is_else = true;
        advance(ast);
    } else if current_token.tt == TK_ELSE && peek.tt == TK_IF {
        // else 
        is_else = true;
        advance(ast);
        advance(ast);
    }
    
    condition: *Expression = 0;
    // TODO/NOTE: probably could check if there is any condition here anyway
    // this would just be a good addition for error messages
    if !skip_condition {
        expr: Expression = ast_create_expr(ast, scope, true);
        condition = calloc(1, sizeof(Expression));
        memcpy(condition, &expr, sizeof(Expression));
    }
    ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
    advance(ast);
    if_block: Block_Node = create_block(ast, false, scope);
    ast_match(ast, TK_CLOSE_CURLY, #FILE, #LINE);
    peek = get_peek(ast);
    next: *If_Node = 0;
    if peek.tt == TK_ELSE {
        advance(ast);
        next_if: If_Node = ast_create_if(ast, scope);
        next = calloc(1, sizeof(If_Node));
        memcpy(next, &next_if, sizeof(If_Node));
    }
    if_node: If_Node = If_Node{ if_block, condition, next, is_else };
    return if_node;
}

is_operator: proc(token: *Token) -> bool {
    if token.tt == TK_GT {
        return true;
    } else if token.tt == TK_GTE {
        return true;
    } else if token.tt == TK_LT {
        return true;
    } else if token.tt == TK_LTE {
        return true;
    } else if token.tt == TK_ASSIGN {
        return true;
    } else if token.tt == TK_ADD_ASSIGN {
        return true;
    } else if token.tt == TK_SUB_ASSIGN {
        return true;
    } else if token.tt == TK_PLUS {
        return true;
    } else if token.tt == TK_DOT {
        return true;
    } else if token.tt == TK_LOGICAL_OR {
        return true;
    } else if token.tt == TK_LOGICAL_AND {
        return true;
    } else if token.tt == TK_OPEN_SQUARE {
        return true;
    } else if token.tt == TK_AMPERSAND {
        return true;
    } else if token.tt == TK_OR {
        return true;
    } else if token.tt == TK_NOT {
        return true;
    } else if token.tt == TK_LEFT_SHIFT {
        return true;
    } else if token.tt == TK_RIGHT_SHIFT {
        return true;
    } else if token.tt == TK_SLASH {
        return true;
    } else if token.tt == TK_STAR {
        return true;
    } else {
        return false;
    }
}

copy_statement: proc(stmt: Statement) -> *Statement {
    stmt_alloc: *Statement = calloc(1, sizeof(Statement));
    memcpy(stmt_alloc, &stmt, sizeof(Statement));
    return stmt_alloc;
}

add_current_directory: proc(ast: *Ast, filename: string) -> string {
    // attempt to try to get the correct directory
    // TODO/NOTE: this is not a great solution but works for now
    // TODO/NOTE: this gets the file directory for the very first file
    //            however this likely doesn't work when you start involving
    //            multiple files
    filepath_tmp: Token = ast.tokens[0];
    filepath_tmp_str: string = filepath_tmp.filename;
    cut_index: i32 = 0;
    for i: i32 = 0; i < filepath_tmp_str.length; i = i + 1 {
        if filepath_tmp_str.ptr[i] == '/' {
            cut_index = i;  
        }
    }

    ret: string;
    if cut_index != 0 {
        sb: String_Builder;
        for i: i32 = 0; i < cut_index + 1; i = i + 1 {
            sb_push(&sb, filepath_tmp_str.ptr[i]);
        }
        for i: i32 = 0; i < filename.length; i = i + 1 {
            sb_push(&sb, filename.ptr[i]);
        }

        ret = sb_to_string(&sb);
        sb_free(&sb);
    } else {
        ret = filename;
    }

    return ret;
}

// returns a malloc'd expression for prolonged use
// TODO: need to figure out this memory situation (i.e. sort out allocs)
allocate_expression: proc(expr: *Expression) -> *Expression {
    ret: *Expression = malloc(sizeof(Expression));
    memcpy(ret, expr, sizeof(Expression));
}

// TODO/NOTE: the copy_statement calls are quite strange here
//            probably needs to be refactored later
create_statement: proc(ast: *Ast, scope: u32) -> *Statement {
    current_token: *Token = get_current_token(ast);
    stmt_ret: *Statement = 0;
    root: bool = false;
    if scope == 0 {
        root = true;
    }
    if current_token.tt == TK_WORD {
        rhs: *Expression = 0;
        // expression or Decl
        name: *Token = current_token;
        peek: *Token = get_peek(ast);
        if peek.tt == TK_COLON {
            advance(ast);
            advance(ast);
            // Declaration
            stmt_type: Type = extract_type(ast);
            skip: bool = false;
            // rhs_check is to make sure to check for rhs 
            // when necessary
            rhs_check: bool = true;
            match type_ := stmt_type {
                Type_Builtin => {
                    // do nothing
                },
                Type_Pointer => {
                    // do nothing
                },
                Type_Proc => {
                    type_.name = name;
                    proc_header: Proc_Header_Node = Proc_Header_Node{ 
                        name, 
                        type_.args, 
                        type_.return_type 
                    };
                    array_append(ast.procs, proc_header);
                    rhs_check = false;
                },
                Type_Array => {
                    // do nothing
                },
                Type_Dynamic_Array => {
                    // do nothing
                },
                Type_Choice => {
                    type_.name = name;
                    array_append(ast.types, stmt_type);
                    skip = true;
                    rhs_check = false;
                },
                Type_Custom_Decl => {
                    type_.name = name;
                    array_append(ast.types, stmt_type);
                    skip = true;
                    rhs_check = false;
                },
                Type_Custom => {
                    // do nothing
                },
                Type_Unknown => {
                    unreachable("We should never encounter this here", #FILE, #LINE);
                }
            }
            // check if rhs needs to be parsed
            ct: *Token = get_current_token(ast); // ct = current_token
            if ct.tt == TK_ASSIGN && rhs_check {
                ast_match(ast, TK_ASSIGN, #FILE, #LINE);
                advance(ast);
                r: Expression = ast_create_expr(ast, scope, false);
                rhs = calloc(1, sizeof(Expression));
                memcpy(rhs, &r, sizeof(Expression));
                ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
            }
            if !skip {
                // we have this because we don't want to add Type_Custom_Decl into the list of statements, they are added to the Ast state and will be generated seperately during the codegen phase 
                var_decl: Variable_Decl_Node = Variable_Decl_Node{ name, rhs, stmt_type, false };
                decl: Decl_Node = Decl_Node{ var_decl };
                stmt: Statement = Statement{ decl };
                stmt_ret = copy_statement(stmt);
                s: *Scope = &ast.scopes[scope];
                array_append(s.map, var_decl);
            }
        } else if peek.tt == TK_OPEN_PAREN {
            assert(!root, "Expressions are not allowed in the top level scope", #FILE, #LINE);
            expr: Expression = ast_create_expr(ast, scope, false);
            expr_stmt: Expression_Statement = Expression_Statement{ expr };
            stmt: Statement = Statement{ expr_stmt };
            stmt_ret = copy_statement(stmt);
        } else if is_operator(peek) || peek.tt == TK_OPEN_PAREN {
            if root {
                print_token(current_token);
            }
            assert(!root, "Expressions are not allowed in the top level scope", #FILE, #LINE);
            expr: Expression = ast_create_expr(ast, scope, false);
            expr_stmt: Expression_Statement = Expression_Statement{ expr };
            stmt: Statement = Statement{ expr_stmt };
            stmt_ret = copy_statement(stmt);
        } else if peek.tt == TK_SHORT_ASSIGN {
            // variable decl
            advance(ast);
            advance(ast);
            r: Expression = ast_create_expr(ast, scope, false);
            rhs = calloc(1, sizeof(Expression));
            memcpy(rhs, &r, sizeof(Expression));
            ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
            unknown: Type_Unknown = Type_Unknown { false, 0 };
            stmt_type: Type = Type { unknown };
            var_decl: Variable_Decl_Node = Variable_Decl_Node{ name, rhs, stmt_type, false };
            decl: Decl_Node = Decl_Node{ var_decl };
            s: *Scope = &ast.scopes[scope];
            array_append(s.map, var_decl);
            stmt: Statement = Statement{ decl };
            stmt_ret = copy_statement(stmt);
        } else {
            tmp: string = current_token.tok;
            printf("Unexpected Token: '%s'\n".ptr, tmp.ptr);
            print_token(current_token);
            panic("", #FILE, #LINE);
        }
    } else if current_token.tt == TK_RETURN {
        advance(ast);
        current_token = get_current_token(ast);
        expr: *Expression = 0;
        if current_token.tt != TK_SEMICOLON {
            expr_tmp: Expression = ast_create_expr(ast, scope, false);
            expr = calloc(1, sizeof(Expression));
            return_node: Return_Node = Return_Node{ expr };
            memcpy(return_node.expr, &expr_tmp, sizeof(Expression));
            ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
            stmt: Statement = Statement{ return_node };
            stmt_ret = copy_statement(stmt);
        } else {
            return_node: Return_Node = Return_Node{ expr };
            ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
            stmt: Statement = Statement{ return_node };
            stmt_ret = copy_statement(stmt);
        }
    } else if current_token.tt == TK_OPEN_PAREN {
        assert(!root, "Expressions are not allowed in the top level scope", #FILE, #LINE);
        expr: Expression = ast_create_expr(ast, scope, false);
        expr_stmt: Expression_Statement = Expression_Statement{ expr };
        stmt: Statement = Statement{ expr_stmt };
        stmt_ret = copy_statement(stmt);
    } else if current_token.tt == TK_IF {
        if_node: If_Node = ast_create_if(ast, scope);
        expr_stmt_with_block: Expression_Statement_With_Block = Expression_Statement_With_Block{ if_node };
        expr_stmt: Expression_Statement = Expression_Statement{ expr_stmt_with_block };
        stmt: Statement = Statement{ expr_stmt };
        stmt_ret = copy_statement(stmt);
    } else if current_token.tt == TK_FOR {
        for_node: For_Node = ast_create_for(ast, scope);
        expr_stmt_with_block: Expression_Statement_With_Block = Expression_Statement_With_Block{ for_node };
        expr_stmt: Expression_Statement = Expression_Statement{ expr_stmt_with_block };
        stmt: Statement = Statement{ expr_stmt };
        stmt_ret = copy_statement(stmt);
    } else if current_token.tt == TK_INCLUDE {
        advance(ast);
        filepath: *Token = get_current_token(ast);
        advance(ast);
        ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
        filepath_str: string = filepath.tok;
        new_filename: string = add_current_directory(ast, filepath_str);
        
        file_src: string = read_file_to_string(new_filename);
        // TODO: take the path of the current file into account like the rust version does
        // TODO: FIX this
        tokens: [+]Token = tokenize(&file_src, filepath_str);
        for i: i32 = array_size(tokens) - 1; i >= 0; i = i - 1 {
            // we doin plus 1 because we want to place the tokens after the index
            array_insert(ast.tokens, tokens[i], ast.index + 1);
        }
    
        // TODO: remove, this is debug printing to check that include works
        for i: i32 = 0; i < array_size(ast.tokens); i = i + 1 {
            print_token(&ast.tokens[i]);
        }
    } else if current_token.tt == TK_CONTINUE {
        advance(ast);
        ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
        cont: Continue_Node = Continue_Node { 0 };
        stmt: Statement = Statement { cont };
        stmt_ret = copy_statement(stmt);
    } else if current_token.tt == TK_BREAK {
        advance(ast);
        ast_match(ast, TK_SEMICOLON, #FILE, #LINE);
        b: Break_Node = Break_Node { 0 };
        stmt: Statement = Statement { b };
        stmt_ret = copy_statement(stmt);
    } else if current_token.tt == TK_MATCH {
        // NOTE: might be useless saving this token 
        match_token: *Token = current_token; // saving for diagnostics
        advance(ast);
        ast_match(ast, TK_WORD, #FILE, #LINE);
        subject_name: *Token = get_current_token(ast);
        subject: *Variable_Decl_Node = 0;
        advance(ast);
        current_token = get_current_token(ast);
        fields: [+]Field = array_new(Field);
        blocks: [+]Block_Node = array_new(Block_Node);
        match_kind: u8 = MATCH_UNKNOWN;
        needs_deref: bool = false; // TODO: handle this
        if current_token.tt == TK_SHORT_ASSIGN {
            match_kind = MATCH_SWITCH;
            advance(ast);
            subject_expr: Expression = ast_create_expr(ast, scope, true);
            subject_rhs: *Expression = allocate_expression(&subject_expr);
            ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
            advance(ast);
            t_unknown: Type_Unknown = Type_Unknown{ false, 0 };
            subject_type: Type = Type{ t_unknown };
            subject_tmp: Variable_Decl_Node = Variable_Decl_Node { 
                subject_name,
                subject_rhs,
                subject_type,
                false
            };
            subject = malloc(sizeof(Variable_Decl_Node));
            memcpy(subject, &subject_tmp, sizeof(Variable_Decl_Node));
            tu: Type_Unknown = Type_Unknown { 0, 0 };
            t: Type = Type{ tu }; // just making this for repeated use below
            for true {
                current_token = get_current_token(ast);
                if current_token.tt == TK_CLOSE_CURLY {
                    break;
                }
                ast_match(ast, TK_WORD, #FILE, #LINE);
                // fill Match_Node with fields of Type_Unknown 
                // and then work it out in static_analysis
                name: *Token = current_token;
                field: Field = Field{ name, t, 0 };
                array_append(fields, field);
                advance(ast);
                ast_match(ast, TK_FAT_ARROW, #FILE, #LINE);
                advance(ast);
                // TODO: handle cases where theres only one statement
                ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
                advance(ast);
                // TODO: put the vardecl into the tihs block
                block: Block_Node = create_block(ast, false, scope);
                array_append(blocks, block);
                save: *Token = get_current_token(ast); // just for the comma diagnostic
                ast_match(ast, TK_CLOSE_CURLY, #FILE, #LINE);
                advance(ast);
                current_token = get_current_token(ast);
                if current_token.tt == TK_COMMA {
                    advance(ast);
                } else if current_token.tt == TK_WORD {
                    compile_error(save, "Expected a comma here");
                }
            }
        } else {
            match_kind = MATCH_SWITCH;
            todo("handle the other kinds of match statement", #FILE, #LINE);
        }
        match_node: Match_Node = Match_Node{ match_kind, fields, subject, blocks, needs_deref, match_token };
        expr_stmt_with_block: Expression_Statement_With_Block = Expression_Statement_With_Block{ match_node };
        expr_stmt: Expression_Statement = Expression_Statement{ expr_stmt_with_block };
        stmt: Statement = Statement{ expr_stmt };
        stmt_ret = copy_statement(stmt);
    } else {
        print_token(current_token);
        tmp: string = current_token.tok;
        printf("Unexpected Token: '%s'\n".ptr, tmp.ptr);
        panic("", #FILE, #LINE);
    }
    return stmt_ret;
}

create_block: proc(ast: *Ast, root: bool, parent_scope: u32) -> Block_Node {
	block: Block_Node;
	block.statements = array_new(Statement);
	block.scope = create_new_scope(ast, parent_scope);
	ast.current_scope = block.scope;

	defers: [+]Statement; // TODO: work on
	for true {
		current_token: *Token = get_current_token(ast);
		if current_token.tt == TK_CLOSE_CURLY {
			if root {
				panic("[ERROR]: Unexpected Close Curly Bracket found in top level scope", #FILE, #LINE);
			} else {
				break;
			}
		}
        
        stmt: *Statement = create_statement(ast, block.scope);
        if stmt != 0 {
            array_append(block.statements, stmt[0]);
        }
		advance(ast);
		if ast.index >= array_size(ast.tokens) {
			break;
		}
	}

	if root {
		print_ast(block);
	}
    ast.current_scope = parent_scope;
	return block;
}

print_indentations: proc(n: i32) {
	sb: String_Builder;
	for i: i32 = 0; i < n; i = i + 1 {
		sb_push(&sb, ' ');
	}
	sb_push(&sb, 0);
	printf("%s".ptr, sb.chars);
	sb_free(&sb);
}

print_expression: proc(expr_: *Expression, indentations: i32) {
    expr: *Expression = expr_; // NOTE/TODO: have to do this because of bug with compiler
    match e := expr {
        Binary_Node => {
            print_indentations(indentations);
            op_str: string = get_op_string(e.op);
            printf("BinaryOp: %s\n".ptr, op_str.ptr);
            print_indentations(indentations + 2);
            printf("lhs:\n".ptr);
            print_expression(e.lhs, indentations + 4);
            print_indentations(indentations + 2);
            printf("rhs:\n".ptr);
            print_expression(e.rhs, indentations + 4);
            // print_indentations(indentations);
            // printf("Binary_Node: %zu\n".ptr, e.val);
        },
        Number_Node => {
            print_indentations(indentations);
            printf("Number: %zu\n".ptr, e.val);
        },
        Variable_Node => {
            print_indentations(indentations);
            // NOTE/TODO: redundant variables due to needing being unable to chain access operator together lol
            token: *Token = e.symbol;
            str: string = token.tok; 
            printf("Number: %\n".ptr, str.ptr);
        },
        Call_Node => {
            print_indentations(indentations);
            name: *Token = e.name;
            name_str: string = name.tok;
            printf("Call: %s\n".ptr, name_str.ptr);
            for i: i32 = 0; i < array_size(e.args); i = i + 1 {
                arg: Expression = e.args[i];
                print_expression(&arg, indentations + 2);
            }
        },
        String_Literal => {
            string_literal: string = e.str;
            print_indentations(indentations);
            printf("String: %s\n".ptr, string_literal.ptr);
        },
        Unary_Node => {
            print_indentations(indentations);
            op_str: string = get_op_string(e.op);
            printf("UnaryOp: %s\n".ptr, op_str.ptr);
            print_indentations(indentations + 2);
            printf("expr:\n".ptr);
            print_expression(e.base, indentations + 4);
        },
        Struct_Init_Node => {
                //StructDeclaration(Some(Token { x: 23, y: 16, tok: "Vector2", tt: Word, filename: "hello.ce" })):
                //    Number: 1
                //    Number: 2
            print_indentations(indentations);
            if e.name == 0 {
                printf("Struct Declaration:\n".ptr);
            } else {
                name_tok: *Token = e.name;
                name_str: string = name_tok.tok;
                printf("Struct Initialization '%s':\n".ptr, name_str.ptr);
            }
            for i: i32 = 0; i < array_size(e.exprs); i = i + 1 {
                print_expression(&e.exprs[i], indentations + 2);
            }
        },
        Array_Literal => {
            print_indentations(indentations);
            printf("ArrayLiteral: [\n".ptr);
            for i: i32 = 0; i < array_size(e.elements); i = i + 1 {
                print_expression(&e.elements[i], indentations + 2);
            }
            print_indentations(indentations);
            printf("]\n".ptr);
        }
    }
}

print_decl: proc(decl: *Decl_Node, indentations: i32) {
    // TODO: this proc has a lot of duplicate code which needs to be refactored
    //       refactor once dev DX is better lol
    // TODO: these prints are not actually working, need to fix it
	tmp: *Decl_Node = decl;
	match decl_ := tmp {
		Variable_Decl_Node => {
			decl_type: Type = decl_.var_type;
			match var_decl_type := decl_type {
				Type_Builtin => {
					print_indentations(indentations + 2);
					printf("Variable Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				},
				Type_Pointer => {
					print_indentations(indentations + 2);
					printf("Variable Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				},
				Type_Proc => {
					print_indentations(indentations + 2);
					printf("Proc Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = var_decl_type.name;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
					if var_decl_type.return_type != 0 {
                        print_indentations(indentations + 4);
                        // TODO: using [0] for dereference lol
                        type_string: string = get_type_string(var_decl_type.return_type[0]);
						printf("return type: %s\n".ptr, type_string.ptr);
					} else {
						print_indentations(indentations + 4);
						printf("return type: (nil)\n".ptr);
					}

					print_indentations(indentations + 4);
					printf("body:\n".ptr);
                    if var_decl_type.block != 0 {
                        print_block(var_decl_type.block, indentations + 6);
                    } else {
                        printf("(Null)\n".ptr);
                    }
				},
				Type_Array => {
					print_indentations(indentations + 2);
					printf("Variable Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				},
				Type_Dynamic_Array => {
					print_indentations(indentations + 2);
					printf("Variable Declaration (DynamicArray):\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				},
				Type_Choice => {
					todo("Type_Choice not implemented (print_decl)", #FILE, #LINE);
				},
                Type_Custom_Decl => {
                    print_indentations(indentations + 2);
                    name_tok: *Token = var_decl_type.name;
                    name_str: string = name_tok.tok;
                    printf("Type Declaration: %s\n".ptr, name_str.ptr);
                    for i: i32 = 0; i < array_size(var_decl_type.fields); i = i + 1 {
                        field: Field = var_decl_type.fields[i];
                        field_token: *Token = field.name;
                        field_str: string = field_token.tok;
                        print_indentations(indentations + 4);
                        t: string = get_type_string(field.type_name);
                        printf("%s: %s\n".ptr, field_str.ptr, t.ptr);
                    }
                    unreachable("Shouldn't have any struct declarations here", #FILE, #LINE);
                },
				Type_Custom => {
                    print_indentations(indentations + 2);
                    name_tok: *Token = var_decl_type.name;
					name_str: string = name_tok.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    type_str: string = name_tok.tok;
                    print_indentations(indentations + 2);
                    printf("Custom Type: %s\n".ptr, type_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				},
                Type_Unknown => {
					print_indentations(indentations + 2);
					printf("Variable Declaration (Type_Unknown):\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    // TODO: print the type
                    if decl_.rhs != 0 {
                        print_indentations(indentations + 4);
                        printf("Initializer:\n".ptr);
                        print_expression(decl_.rhs, indentations + 6);
                        // todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
                }
			}
		}
	}
}

print_if_statement: proc(if_node: *If_Node, indentations: i32) {
    if if_node.condition != 0 {
        print_indentations(indentations);
        printf("If Statement:\n".ptr);
        print_indentations(indentations + 2);
        printf("Condition:\n".ptr);
        print_expression(if_node.condition, indentations + 2);
    } else {
        print_indentations(indentations);
        printf("Else:\n".ptr);
    }
    print_block(&if_node.block, indentations + 2);
    if if_node.next != 0 {
        print_if_statement(if_node.next, indentations);
    } 
}

print_for: proc(for_node: *For_Node, indentations: i32) {
     print_indentations(indentations);
     printf("For Statement (TODO):\n".ptr);
     print_indentations(indentations);
     if for_node.is_classic_for {
         // todo("printing for classical for loops", #FILE, #LINE);
     }
     printf("Condition:\n".ptr);
     if for_node.condition {
        print_expression(for_node.condition, indentations + 2);
     } else {
        printf("(none)\n".ptr);
     }
     print_block(&for_node.block, indentations);
}

print_expression_with_block: proc(expr_block_: *Expression_Statement_With_Block, indentations: i32) {
    print_indentations(indentations);
    printf("Expression Statement (with block): \n".ptr);
    expr_block: *Expression_Statement_With_Block = expr_block_;
    match e_block := expr_block {
        If_Node => {
            print_if_statement(e_block, indentations);
        },
        For_Node => {
            print_for(e_block, indentations);
        }
    }
}

print_block: proc(block: *Block_Node, indentations: i32) {
	print_indentations(indentations);
	printf("Block {\n".ptr);
	for i: i32 = 0; i < array_size(block.statements); i = i + 1 {
		 print_indentations(indentations + 2);
		 printf("[%d]\n".ptr, i);
		 stmt: Statement = block.statements[i];
		 match type_ := stmt {
		 	Expression_Statement => {
                // TODO/NOTE: doing this declaration because type_ is not added in the scope
                t: *Expression_Statement = type_;
                print_indentations(indentations + 2);
                printf("Expression Statement:\n".ptr);
                match e := t {
                    Expression => {
                        print_expression(e, indentations + 4);
                    },
                    Expression_Statement_With_Block => {
                        print_expression_with_block(e, indentations + 4);
                    }
                }
		 	},
		 	Decl_Node => {
				print_decl(type_, indentations + 4);
		 	},
            Return_Node => {
                print_indentations(indentations + 4);
		 		printf("Return: \n".ptr);
                if type_.expr == 0 {
                    print_indentations(indentations + 6);
                    printf("(none)\n".ptr);
                } else {
                    print_expression(type_.expr, indentations + 6);
                }
            }
		 }
	}	
	print_indentations(indentations);
	printf("}\n".ptr);
}

print_ast: proc(root: Block_Node) {
	printf("===== PRINTING AST ======\n".ptr);
	indentations: i32 = 0;

	for i: i32 = 0; i < array_size(root.statements); i = i + 1 {
		 print_indentations(indentations + 2);
		 printf("[%d]\n".ptr, i);
		 stmt: Statement = root.statements[i];
		 match type_ := stmt {
		 	Expression_Statement => {
		 		todo("print_ast for Expression_Statement", #FILE, #LINE);
		 	},
		 	Decl_Node => {
				print_decl(type_, indentations + 2);
		 	},
            Return_Node => {
                unreachable("There should not be returns at the top level scope", #FILE, #LINE);
            }
		 }
	}	
	
	printf("=========================\n".ptr);
}

