resolve_include_path: proc(base_file: string, include_path: string) -> string {
    cut: i32 = 0;
    for i: i32 = 0; i < base_file.length; i = i + 1 {
        if base_file.ptr[i] == '/' {
            cut = i;
        }
    }
    if cut == 0 {
        return include_path;
    }
    sb: String_Builder;
    for i: i32 = 0; i < cut + 1; i = i + 1 {
        sb_push(&sb, base_file.ptr[i]);
    }
    for i: i32 = 0; i < include_path.length; i = i + 1 {
        sb_push(&sb, include_path.ptr[i]);
    }
    return sb_to_string(&sb);
}

expand_includes: proc(tokens: [+]Token, base_filename: string) -> [+]Token {
    result: [+]Token = array_new(Token);
    len: i32 = array_size(tokens);
    i: i32 = 0;
    for i < len {
        tok: Token = tokens[i];
        if tok.tt != TK_INCLUDE {
            array_append(result, tok);
            i = i + 1;
        } else {
            assert(i + 2 < len, "malformed include directive", #FILE, #LINE);
            filepath_tok: Token = tokens[i + 1];
            filepath_str: string = filepath_tok.tok;
            semicolon_tok: Token = tokens[i + 2];
            assert(semicolon_tok.tt == TK_SEMICOLON, "expected ';' after include", #FILE, #LINE);

            full_path: string = resolve_include_path(base_filename, filepath_str);
            src: string = read_file_to_string(full_path);
            child_tokens: [+]Token = tokenize(&src, filepath_str);
            expanded: [+]Token = expand_includes(child_tokens, full_path);

            for j: i32 = 0; j < array_size(expanded); j = j + 1 {
                array_append(result, expanded[j]);
            }

            array_free(child_tokens);
            array_free(expanded);
            i = i + 3;
        }
    }
    return result;
}

ast_start: proc(tokens: [+]Token) -> Ast {
	ast: Ast;
	// init ast
	ast.tokens = tokens;
    ast.strings_index = 0;
	ast.index = 0;
	ast.scopes = array_new(Scope);
	ast.types = array_new(Type);
    ast.procs = array_new(Proc_Header_Node);
	ast.strings = array_new(String_Literal);
	ast.root_block = create_block(&ast, true, 0 - 1);
	
    return ast;
}
