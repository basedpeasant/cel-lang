

TYPE_U8:       u8 = 1;
TYPE_U16:      u8 = 2;
TYPE_U32:      u8 = 3;
TYPE_U64:      u8 = 4;
TYPE_I8:       u8 = 5;
TYPE_I16:      u8 = 6;
TYPE_I32:      u8 = 7;
TYPE_I64:      u8 = 8;
TYPE_BOOL:     u8 = 9;
TYPE_VOID_PTR: u8 = 10;
TYPE_STRING:   u8 = 11;
TYPE_CUSTOM:   u8 = 12;

Attribute: type struct {
	
}

Type_Custom: type struct {
	name: *Token,
	fields: [+]Field
}

Type_Builtin: type struct {
	kind: u8,
	attributes: [+]Attribute
}

Type_Pointer: type struct {
	
}

Block_Node: type struct {
	statements: [+]Statement,
	scope: u32
}

Type_Proc: type struct {
	attributes: [+]Attribute,
	args: [+]Variable_Decl_Node,
	return_type: *Type,
	name: *Token,
	block: Block_Node,
}

Type_Array: type struct {
	
}

Type_Dynamic_Array: type struct {
	
}

Type_Choice: type struct {
	
}

Type: type choice {
	Type_Builtin,
	Type_Pointer,
	Type_Proc,
	Type_Array,
	Type_Dynamic_Array,
	Type_Choice,
	Type_Custom
}

Field: type struct {
	name: Token,
	type_name: Type,
}

String_Literal: type struct {
	str: string
}

Strings_Map: type struct {
	key: *u8,
	value: String_Literal
}

Variable_Decl_Node: type struct {
	symbol: *Token,
	rhs: *Expression,
	var_type: Type,
	is_arg: bool
}

//VarDecl_Map: type struct {
//	key: *u8,
//	value: Variable_Decl_Node
//}

Scope: type struct {
	parent_scope: i32,
	id: i32,
	map: [+]Variable_Decl_Node
}

Number_Node: type struct {
	val: i64
}

Expression: type choice {
    // Index(IndexNode),
    // Binary(BinaryOpNode),
    Number_Node,
    // Variable(VariableNode),
    // Call(CallNode),
    // String(StringLiteral),
    // Char(CharLiteral),
    // Array(ArrayLiteral),
    // Struct(StructDeclarationNode),
    // Reference(Box<Expression>), // TODO: this should actually be unary node
    // Not(Box<Expression>), // TODO: this should actually be unary node
}

For_Node: type struct {
	block: Block_Node,
	is_classic_for: bool,
	init: *Statement,
	condition: *Expression
}

Expression_Statement_With_Block: type choice {
	// IfNode,
	// ForNode,
	// MatchNode,
}

Expression_Statement: type choice {
	// ReturnNode,
	Expression,
	// DeferNode,
	// ExpressionStatementWithBlock
}

Proc_Node: type struct {
	name: Token,
	block: Block_Node,
	args: [+]Variable_Decl_Node,
	return_Type: *Type,
	// attributes: [+]Attribute // need enum support
}

Decl_Node: type choice {
	// Proc_Node,
	Variable_Decl_Node
}

Statement: type choice {
	Expression_Statement,
	Decl_Node,
	// Break,
	// Continue
}

Ast: type struct {
	root_block: Block_Node,
	tokens: [+]Token,
	index: u32,
	scopes: [+]Scope,
	types: [+]Type,
	strings: Strings_Map,
	current_scope: u32,
}

find_name_in_scope: proc(ast: *Ast, scope_id: i32, name: string) -> *Variable_Decl_Node {
	size: i32 = array_size(ast.scopes);
	if scope_id < 0 || scope_id >= size {
		return 0;
	}
	scope: Scope = ast.scopes[scope_id];

	for i: i32 = 0; i < size; i = i + 1 {
		// var_decl: Variable_Decl_Node = scope.map[i];
		// if strcmp(name, var_decl.symbol.tok) {
			// return &scope.map[i];
		// }
	}
	return 0;
}

create_new_scope: proc(ast: *Ast, parent_scope: i32) -> i32 {
	scope: Scope = Scope{parent_scope, array_size(ast.scopes), array_new(Variable_Decl_Node)};
	array_append(ast.scopes, scope);
	return array_size(ast.scopes) - 1;
}

get_current_token: proc(ast: *Ast) -> *Token {
	if ast.index >= array_size(ast.tokens) {
		return 0;
	}
	return &ast.tokens[ast.index];
}

get_peek: proc(ast: *Ast) -> *Token {
	if ast.index + 1 >= array_size(ast.tokens) {
		return 0;
	}
	return &ast.tokens[ast.index + 1];
}

ast_match: proc(ast: *Ast, tt: u8, file: string, line: i32) {
	// file and line are for debugging purposes
	current_token: *Token = get_current_token(ast);
	if current_token.tt != tt {
		printf("[ERROR]: Expected %d but got %d\n".ptr, tt, current_token.tt);
		panic("Compiler failed", file, line);
	}
}

advance: proc(ast: *Ast) {
	ast.index = ast.index + 1;
}

