get_type: proc(token: *Token) -> Type {
	if strcmp(token.tok, "u8") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U8, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u16") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U16, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u32") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U32, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u64") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U64, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i8") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I8, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i16") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I16, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i32") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I32, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i64") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I64, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "bool") {
		inner: Type_Builtin = Type_Builtin{ TYPE_BOOL, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "void_ptr") {
		inner: Type_Builtin = Type_Builtin{ TYPE_VOID_PTR, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "string") {
		inner: Type_Builtin = Type_Builtin{ TYPE_STRING, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "proc") {
		inner: Type_Proc = Type_Proc{ array_new(Attribute), array_new(Variable_Decl_Node), 0 };
		ret: Type = Type{ inner };
		return ret;
	} else {
		token_str: string = token.tok;
		printf("%s\n".ptr, token_str.ptr);
		todo("handle custom types", #FILE, #LINE);
	}
}

extract_type: proc(ast: *Ast) -> Type {
	current_token: *Token = get_current_token(ast);
	if current_token.tt == TK_WORD {
		// TODO: certain types need to be modified after get_type
		//       e.g. pointers, procs, arrays, etc
		//       types like string, void_ptr, u8, etc don't 
		t: Type = get_type(current_token);
        // TODO: need to be able to handle attributes
		match _x := t {
			Type_Builtin => {
                advance(ast);
                return t;
			}, // do nothing 
			Type_Pointer => {
				todo("handling for Type_Pointer", #FILE, #LINE);
			},
			Type_Array => {
				todo("handling for Type_Array", #FILE, #LINE);
			},
			Type_Proc => {
				unreachable("handled else where since 'proc' can never be a TK_WORD", #FILE, #LINE);
			}
			Type_Dynamic_Array => {
				todo("handling for Type_Dynamic_Array", #FILE, #LINE);
			},
			Type_Choice => {
				todo("handling for Type_Choice", #FILE, #LINE);
			},
			Type_Custom => {
				todo("handling for Type_Custom", #FILE, #LINE);
			}
		}
	} else if current_token.tt == TK_PROC {
		advance(ast);
		ast_match(ast, TK_OPEN_PAREN, #FILE, #LINE);
		advance(ast);
		// TODO: do args

		ast_match(ast, TK_CLOSE_PAREN, #FILE, #LINE);
		advance(ast);
		// TODO: return type
		attributes: [+]Attribute; //TODO: need to populate as well
		args: [+]Variable_Decl_Node;
		return_type: *Type = 0;

		ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
		advance(ast);
		proc_block: Block_Node = create_block(ast, false, ast.current_scope);
		ast_match(ast, TK_CLOSE_CURLY, #FILE, #LINE);

		proc_type: Type_Proc = Type_Proc{ attributes, args, return_type, 0, proc_block };
		ret: Type = Type { proc_type };
		return ret;
		// todo("handling for Type_Proc", #FILE, #LINE);
	} else if current_token.tt == TK_STAR {
		todo("not implemented yet", #FILE, #LINE);
	} else {
		current_token_str: string = current_token.tok;
		printf("%s\n".ptr, current_token_str.ptr);
		todo("Unexpected Token", #FILE, #LINE);
	}
}

print_type: proc(var_type: Type) {
	v: Type = var_type;
	// NOTE/TODO: this _x has to be there because of the way the compiler works rn
	// obviously remove it once the match code supports it not being there
	match _x := v {
		Type_Builtin => {
			todo("printing for Type_Builtin", #FILE, #LINE);
		}, 
		Type_Pointer => {
			todo("printing for Type_Pointer", #FILE, #LINE);
		},
		Type_Proc => {
			printf("Type: Proc\n".ptr);
			//todo("printing for Type_Proc", #FILE, #LINE);
		},
		Type_Array => {
			todo("printing for Type_Array", #FILE, #LINE);
		},
		Type_Dynamic_Array => {
			todo("printing for Type_Dynamic_Array", #FILE, #LINE);
		},
		Type_Choice => {
			todo("printing for Type_Choice", #FILE, #LINE);
		},
		Type_Custom => {
			todo("printing for Type_Custom", #FILE, #LINE);
		}
	}
}

create_block: proc(ast: *Ast, root: bool, parent_scope: i32) -> Block_Node {
	block: Block_Node;
	block.statements = array_new(Statement);
	block.scope = create_new_scope(ast, parent_scope);
	ast.current_scope = block.scope;

	defers: [+]Statement; // TODO: work on
	for true {
		current_token: *Token = get_current_token(ast);
		if current_token.tt == TK_CLOSE_CURLY {
			if root {
				panic("[ERROR]: Unexpected Close Curly Bracket found in top level scope", #FILE, #LINE);
			} else {
				break;
			}
		}
		if current_token.tt == TK_WORD {
			// expression or Decl
			name: *Token = current_token;
			peek: *Token = get_peek(ast);
			if peek.tt == TK_COLON {
				advance(ast);
				advance(ast);
				// Declaration
				stmt_type: Type = extract_type(ast);
				match type_ := stmt_type {
					Type_Builtin => {
                        // parse RHS if it exists
                        ct: *Token = get_current_token(ast); // ct = current_token
                        if ct.tt == TK_ASSIGN {
                            todo("Need to parse rhs; not implemented yet", #FILE, #LINE);
                        } else {
                            ast_match(ast, TK_SEMICOLON, #FILE, #LINE); // needs to be the end of the statement otherwise
                        }
					}
					Type_Pointer => {
						todo("Type_Pointer not implemented yet", #FILE, #LINE);
					}
					Type_Proc => {
						type_.name = name;
					}
					Type_Array => {
						todo("Type_Array not implemented yet", #FILE, #LINE);
					}
					Type_Dynamic_Array => {
						todo("Type_Dynamic_Array not implemented yet", #FILE, #LINE);
					}
					Type_Choice => {
						todo("Type_Choice not implemented yet", #FILE, #LINE);
					}
					Type_Custom => {
						todo("Type_Custom not implemented yet", #FILE, #LINE);
					}
				}
				var_decl: Variable_Decl_Node = Variable_Decl_Node{ name, 0, stmt_type, false };
				decl: Decl_Node = Decl_Node{ var_decl };
				stmt: Statement = Statement{ decl };
				array_append(block.statements, stmt);
			}
			// todo("implement", #FILE, #LINE);
		}

		advance(ast);
		if ast.index >= array_size(ast.tokens) {
			break;
		}
	}

	if root {
		print_ast(block);
	}
	return block;
}

print_indentations: proc(n: i32) {
	sb: String_Builder;
	for i: i32 = 0; i < n; i = i + 1 {
		sb_push(&sb, ' ');
	}
	sb_push(&sb, 0);
	printf("%s".ptr, sb.chars);
	sb_free(&sb);
}
//Block {
//  [0]
//    Proc Declaration:
//      name: "main"
//      body:
//        Block {
//          [0]
//            Variable Declaration:
//              name: "a"
//              type: i32
//              initializer: (none)
//        }

print_decl: proc(decl: *Decl_Node, indentations: i32) {
	tmp: *Decl_Node = decl;
	match decl_ := tmp {
		// Proc_Node => {
			
		// },
		Variable_Decl_Node => {
			decl_type: Type = decl_.var_type;
			match var_decl_type := decl_type {
				Type_Builtin => {
					print_indentations(indentations + 2);
					printf("Variable Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = decl_.symbol;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
                    if decl_.rhs != 0 {
                        todo("Type_Builtin printing rhs (print_decl)", #FILE, #LINE);
                    } else {
                        print_indentations(indentations + 4);
                        printf("Initializer: (none)\n".ptr);
                    }
				}
				Type_Pointer => {
					todo("Type_Pointer not implemented (print_decl)", #FILE, #LINE);
				}
				Type_Proc => {
					print_indentations(indentations + 2);
					printf("Proc Declaration:\n".ptr);
					print_indentations(indentations + 4);
					token_symbol: *Token = var_decl_type.name;
					name_str: string = token_symbol.tok;
					printf("name: '%s'\n".ptr, name_str.ptr);
					if var_decl_type.return_type != 0 {
						todo("Printing for return types", #FILE, #LINE);
					} else {
						print_indentations(indentations + 4);
						printf("return type: (nil)\n".ptr);
					}

					print_indentations(indentations + 4);
					printf("body:\n".ptr);
					print_block(&var_decl_type.block, indentations + 6);
				}
				Type_Array => {
					todo("Type_Array not implemented (print_decl)", #FILE, #LINE);
				}
				Type_Dynamic_Array => {
					todo("Type_Dynamic_Array not implemented (print_decl)", #FILE, #LINE);
				}
				Type_Choice => {
					todo("Type_Choice not implemented (print_decl)", #FILE, #LINE);
				}
				Type_Custom => {
					todo("Type_Custom not implemented (print_decl)", #FILE, #LINE);
				}
			}
		}
	}
}

print_block: proc(block: *Block_Node, indentations: i32) {
	print_indentations(indentations);
	printf("Block {\n".ptr);
	for i: i32 = 0; i < array_size(block.statements); i = i + 1 {
		 print_indentations(indentations + 2);
		 printf("[%d]\n".ptr, i);
		 stmt: Statement = block.statements[i];
		 match type_ := stmt {
		 	Expression_Statement => {
		 		todo("print_ast for Expression_Statement", #FILE, #LINE);
		 	},
		 	Decl_Node => {
				print_decl(type_, indentations + 4);
		 	}
		 }
	}	
	print_indentations(indentations);
	printf("}\n".ptr);
}

print_ast: proc(root: Block_Node) {
	printf("===== PRINTING AST ======\n".ptr);
	indentations: i32 = 0;

	for i: i32 = 0; i < array_size(root.statements); i = i + 1 {
		 print_indentations(indentations + 2);
		 printf("[%d]\n".ptr, i);
		 stmt: Statement = root.statements[i];
		 match type_ := stmt {
		 	Expression_Statement => {
		 		todo("print_ast for Expression_Statement", #FILE, #LINE);
		 	},
		 	Decl_Node => {
				print_decl(type_, indentations + 2);
		 	}
		 }
	}	
	
	printf("=========================\n".ptr);
}

ast_start: proc(tokens: [+]Token) -> Ast {
	ast: Ast;
	// init ast
	ast.tokens = tokens;
	ast.index = 0;
	ast.scopes = array_new(Scope);
	ast.types = array_new(Type);
	strings: Strings_Map = Strings_Map{0}; // NOTE: cannot do this in one line at the moment
	ast.strings = strings;
	ast.root_block = create_block(&ast, true, 0 - 1);
	
}
