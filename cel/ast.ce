

TYPE_U8:                   u8 = 1;
TYPE_U16:                  u8 = 2;
TYPE_U32:                  u8 = 3;
TYPE_U64:                  u8 = 4;
TYPE_I8:                   u8 = 5;
TYPE_I16:                  u8 = 6;
TYPE_I32:                  u8 = 7;
TYPE_I64:                  u8 = 8;
TYPE_BOOL:                 u8 = 9;
TYPE_VOID_PTR:             u8 = 10;
TYPE_STRING:               u8 = 11;
TYPE_CUSTOM:               u8 = 12; // TODO probably don't need it, its only for builtin types
TYPE_CUSTOM_DECLARATION:   u8 = 13; // TODO probably don't need it, its only for builtin types
TYPE_VOID:                 u8 = 14;
TYPE_UNKNOWN:              u8 = 15; // FOR TYPE INFERENCE

ATTRIBUTE_EXTERN: u8 = 1;
ATTRIBUTE_STATIC: u8 = 2;
ATTRIBUTE_UNKNOWN: u8 = 3;
Attribute: type struct {
    kind: u8,
    //expr: Expression*
}

// this is kind of hacky tbh
Type_Unknown: type struct {
    resolved: bool,
    type_: *Type,
}

Type_Custom: type struct {
	name: *Token,
	attributes: [+]Attribute
}

Type_Custom_Decl: type struct {
	name: *Token,
	fields: [+]Field,
	attributes: [+]Attribute
}

Type_Builtin: type struct {
	kind: u8,
	attributes: [+]Attribute
}

Type_Choice: type struct {
    name: *Token,
    fields: [+]Field,
	attributes: [+]Attribute
}

Return_Node: type struct {
    expr: *Expression,
}

Block_Node: type struct {
	statements: [+]Statement,
	scope: u32
}

Type_Proc: type struct {
	attributes: [+]Attribute,
	args: [+]Variable_Decl_Node,
	return_type: *Type,
	name: *Token,
	block: *Block_Node,
    default_vals: [+]Expression,
}

Type_Array: type struct {
    size: *Expression,
    array_type: *Type
}

Type_Dynamic_Array: type struct {
    array_type: *Type,	
}

Type_Pointer: type struct {
	inner: *Type,
}

Type: type choice {
	Type_Builtin,
	Type_Pointer,
	Type_Proc,
	Type_Array,
	Type_Dynamic_Array,
	Type_Choice,
	Type_Custom_Decl,
	Type_Custom,
    Type_Unknown
}

Field: type struct {
	name: *Token,
	type_name: Type,
    tag: u8
}

String_Literal: type struct {
	str: string,
    index: i32
}

Strings_Map: type struct {
	key: *u8,
	value: String_Literal
}

Variable_Decl_Node: type struct {
	symbol: *Token,
	rhs: *Expression,
	var_type: Type,
	is_arg: bool
}

Variable_Node: type struct {
    symbol: *Token, 
}

//VarDecl_Map: type struct {
//	key: *u8,
//	value: Variable_Decl_Node
//}

Scope: type struct {
	parent_scope: u32,
	id: u32,
	map: [+]Variable_Decl_Node
}

Number_Node: type struct {
	val: u64
}

OP_ADD: i32 = 10;
OP_SUB: i32 = 11;
OP_MUL: i32 = 12;
OP_DIV: i32 = 13;
OP_OR: i32 = 14;
OP_LOGICAL_OR: i32 = 15;
OP_GT: i32 = 16;
OP_GTE: i32 = 17;
OP_LT: i32 = 18;
OP_LTE: i32 = 19;
OP_EQUAL: i32 = 20;
OP_NOT_EQUAL: i32 = 21;
OP_REFERENCE: i32 = 22;
OP_ASSIGN: i32 = 23;
OP_ARRAY_INDEX: i32 = 24;
OP_ACCESS: i32 = 25;
OP_NOT: i32 = 26;
OP_AND: i32 = 27;
OP_LOGICAL_AND: i32 = 28;
OP_LEFT_SHIFT: i32 = 29;
OP_RIGHT_SHIFT: i32 = 30;
OP_BITWISE_XOR: i32 = 31;
OP_BITWISE_NOT: i32 = 32;
OP_ADD_ASSIGN: i32 = 33;
OP_SUB_ASSIGN: i32 = 34;
OP_DEREF: i32 = 35;
OP_MOD: i32 = 36;

Unary_Node: type struct {
    op: i32,
    base: *Expression,
    expr: *Expression,
}

Binary_Node: type struct {
    op: i32,
    lhs: *Expression,
    rhs: *Expression
}

Call_Node: type struct {
    name: *Token,
    args: [+]Expression
}

Struct_Init_Node: type struct {
    name: *Token,
    exprs: [+]Expression,
    is_choice: bool,
    tag: i32
}

Array_Literal: type struct {
    elements: [+]Expression,
    size: u32 // TODO: prob not needed
}

// NOTE: DUE TO THE WAY WE ARE CURRENTLY DOING THIS THE ORDER FOR THIS MUST STAY THE SAME
Expression: type choice {
    Binary_Node,
    Number_Node,
    Variable_Node,
    Call_Node,
    String_Literal,
    Unary_Node,
    Struct_Init_Node,
    Array_Literal,
    // Index(IndexNode),
    // Variable(VariableNode),
    // Call(CallNode),
    // String(StringLiteral),
    // Char(CharLiteral),
    // Array(ArrayLiteral),
    // Struct(StructDeclarationNode),
    // Reference(Box<Expression>), // TODO: this should actually be unary node
    // Not(Box<Expression>), // TODO: this should actually be unary node
}

If_Node: type struct {
    block: Block_Node,
    condition: *Expression,
    next: *If_Node,
    is_else: bool
}

For_Node: type struct {
	block: Block_Node,
	is_classic_for: bool,
	init: *Statement,
	condition: *Expression,
    post: *Expression
}

MATCH_SWITCH:  u8 = 0;
MATCH_CHOICE:  u8 = 1;
MATCH_UNKNOWN: u8 = 2; // NOTE: should result in a error if encountered

Match_Node: type struct {
    match_kind: u8,
    fields: [+]Field,
    subject: *Variable_Decl_Node,
    blocks: [+]Block_Node,
    needs_deref: bool,
    token: *Token, // for diagnostics (maybe(?) //TODO: maybe not)
}

Expression_Statement_With_Block: type choice {
	If_Node,
	For_Node,
	Match_Node,
}

Expression_Statement: type choice {
	// ReturnNode,
	Expression,
	// DeferNode,
	Expression_Statement_With_Block
}

Proc_Header_Node: type struct {
	name: *Token,
	// block: Block_Node,
	args: [+]Variable_Decl_Node,
	return_type: *Type,
	// attributes: [+]Attribute // need enum support
}

Decl_Node: type choice {
	// Proc_Node,
	Variable_Decl_Node
}

// this should be an enum actually but we can't do that right now
Continue_Node: type struct {
    _dummy: u8,
}

// this should be an enum actually but we can't do that right now
Break_Node: type struct {
    _dummy: u8,
}

Statement: type choice {
	Expression_Statement,
	Decl_Node,
    Return_Node,
    Continue_Node,
    Break_Node,
}

Ast: type struct {
	root_block: Block_Node,
	tokens: [+]Token,
	index: u32,
	scopes: [+]Scope,
    types: [+]Type,
	strings: [+]String_Literal,
    strings_index: i32,
	current_scope: u32,
    procs: [+]Proc_Header_Node
}

// TODO: marked for removal (not used rn)
find_name_in_scope: proc(ast: *Ast, scope_id: i32, name: string) -> *Variable_Decl_Node {
	size: i32 = array_size(ast.scopes);
	if scope_id < 0 || scope_id >= size {
		return 0;
	}
	scope: Scope = ast.scopes[scope_id];

	for i: i32 = 0; i < size; i = i + 1 {
		// var_decl: Variable_Decl_Node = scope.map[i];
		// if strcmp(name, var_decl.symbol.tok) {
			// return &scope.map[i];
		// }
	}
	return 0;
}

create_new_scope: proc(ast: *Ast, parent_scope: i32) -> i32 {
	scope: Scope = Scope{parent_scope, array_size(ast.scopes), array_new(Variable_Decl_Node)};
	array_append(ast.scopes, scope);
	return array_size(ast.scopes) - 1;
}

get_current_token: proc(ast: *Ast) -> *Token {
	if ast.index >= array_size(ast.tokens) {
		return 0;
	}
	return &ast.tokens[ast.index];
}

get_peek: proc(ast: *Ast) -> *Token {
	if ast.index + 1 >= array_size(ast.tokens) {
		return 0;
	}
	return &ast.tokens[ast.index + 1];
}

ast_match: proc(ast: *Ast, tt: u8, file: string, line: i32) {
	// file and line are for debugging purposes
	current_token: *Token = get_current_token(ast);
    current_token_str: string = current_token.tok;
    tt_str: string = get_tt_string_repr(current_token.tt);
    tt_expected: string = get_tt_string_repr(tt);
	if current_token.tt != tt {
		sb: String_Builder;
		sb_push_str(&sb, "Expected ");
		sb_push_str(&sb, tt_expected);
		sb_push_str(&sb, " but got ");
		sb_push_str(&sb, tt_str);
		sb_push_str(&sb, " ('");
		sb_push_str(&sb, current_token_str);
		sb_push_str(&sb, "')");
		msg: string = sb_to_string(&sb);
		compile_error(current_token, msg);
	}
}

advance: proc(ast: *Ast) {
	ast.index = ast.index + 1;
}

// NOTE: we use Type instead of *Type because we don't support matching with 
//       choice types that are pointers and also it doesn't matter having a copy
//       here anyway
// TODO: uncomment out this once below match is fixed
get_type_string: proc(type__: Type) -> string {
   // NOTE: have to redeclare cus of a bug lol
   type_: Type = type__;
   match x := type_ {
       Type_Builtin => {
           kind: i32 = x.kind;
           if kind == TYPE_U8 {
               return "u8";
           } else if kind == TYPE_U16 {
               return "u16";
           } else if kind == TYPE_U32 {
               return "u32";
           } else if kind == TYPE_U64 {
               return "u64";
           } else if kind == TYPE_I8 {
               return "i8";
           } else if kind == TYPE_I16 {
               return "i16";
           } else if kind == TYPE_I32 {
               return "i32";
           } else if kind == TYPE_I64 {
               return "i64";
           } else if kind == TYPE_STRING {
               return "string";
           } else if kind == TYPE_BOOL {
               return "bool";
           } else if kind == TYPE_VOID_PTR {
               return "void*";
           } else {
               printf("\n%d\n".ptr, kind);
               todo("implement get_type_string for Type_Builtin", #FILE, #LINE);
           }
       },
       Type_Pointer => { 
           todo("implement get_type_string for Type_Pointer", #FILE, #LINE);
       },
       Type_Proc => { 
           todo("implement get_type_string for Type_Proc", #FILE, #LINE);
       },
       Type_Array => { 
           todo("implement get_type_string for Type_Array", #FILE, #LINE);
       },
       Type_Dynamic_Array => { 
           todo("implement get_type_string for Type_Dynamic_Array", #FILE, #LINE);
       },
       Type_Choice => { 
           todo("implement get_type_string for Type_Choice", #FILE, #LINE);
       },
       Type_Custom_Decl => {
           todo("implement get_type_string for Type_Custom_Decl", #FILE, #LINE);
       },
       Type_Custom => { 
           name: *Token = x.name;
           return name.tok;
       },
       Type_Unknown => {
           return "UNKNOWN";
       }
   }
}

get_type: proc(token: *Token) -> Type {
	if strcmp(token.tok, "u8") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U8, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u16") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U16, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u32") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U32, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "u64") {
		inner: Type_Builtin = Type_Builtin{ TYPE_U64, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i8") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I8, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i16") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I16, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i32") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I32, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "i64") {
		inner: Type_Builtin = Type_Builtin{ TYPE_I64, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "bool") {
		inner: Type_Builtin = Type_Builtin{ TYPE_BOOL, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "void_ptr") {
		inner: Type_Builtin = Type_Builtin{ TYPE_VOID_PTR, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "string") {
		inner: Type_Builtin = Type_Builtin{ TYPE_STRING, array_new(Attribute) };
		ret: Type = Type{ inner };
		return ret;
	} else if strcmp(token.tok, "proc") {
        unreachable("Procs are handled elsewhere", #FILE, #LINE);
        // TODO: consider getting rid of this below
		inner: Type_Proc;
        inner.attributes = array_new(Attribute);
        inner.args = array_new(Variable_Decl_Node);
        inner.return_type = 0;
        inner.name = 0;
        inner.default_vals = array_new(Expression);
		ret: Type = Type{ inner };
		return ret;
	} else {
        inner: Type_Custom = Type_Custom{ token, array_new(Attribute) };
        ret: Type = Type{ inner };
        return ret;
	}
}

extract_attributes: proc(ast: *Ast) -> [+]Attribute {
    ret: [+]Attribute;

    for true {
        current_token: *Token = get_current_token(ast);
        if current_token.tt == TK_AT {
            tmp: Attribute = Attribute { ATTRIBUTE_UNKNOWN };
            advance(ast);
            current_token = get_current_token(ast);
            assert(current_token.tt == TK_WORD, "Expected a keyword after @ but got something else", #FILE, #LINE);
            if strcmp(current_token.tok, "extern") {
                tmp.kind = ATTRIBUTE_EXTERN;
                array_append(ret, tmp);
            } else if strcmp(current_token.tok, "static") {
                tmp.kind = ATTRIBUTE_STATIC;
                array_append(ret, tmp);
            } else {
                printf("%s".ptr, current_token.tok);
                panic("Attribute is not recognized", #FILE, #LINE);
            }
            advance(ast);
        } else {
            break;
        }
    }
    return ret;
}

extract_type: proc(ast: *Ast) -> Type {
	current_token: *Token = get_current_token(ast);
	if current_token.tt == TK_WORD {
		// TODO: certain types need to be modified after get_type
		//       e.g. pointers, procs, arrays, etc
		//       types like string, void_ptr, u8, etc don't 
		t: Type = get_type(current_token);
        // TODO: need to be able to handle attributes
		match _x := t {
			Type_Builtin => {
                advance(ast);
                return t;
			}, // do nothing 
			Type_Pointer => {
				todo("handling for Type_Pointer", #FILE, #LINE);
			},
			Type_Proc => {
				unreachable("handled else where since 'proc' can never be a TK_WORD", #FILE, #LINE);
			},
			Type_Array => {
				todo("handling for Type_Array", #FILE, #LINE);
			},
			Type_Dynamic_Array => {
				todo("handling for Type_Dynamic_Array", #FILE, #LINE);
			},
			Type_Choice => {
				todo("handling for Type_Choice", #FILE, #LINE);
			},
            Type_Custom_Decl => {
				unreachable("handled else where since 'type' can never be a TK_WORD", #FILE, #LINE);
            },
			Type_Custom => {
                advance(ast);
                return t;
                // do nothing?
			},
            Type_Unknown => {
                unreachable("handled else where, should not encounter this case", #FILE, #LINE);
            }
		}
	} else if current_token.tt == TK_PROC {
		advance(ast);
		ast_match(ast, TK_OPEN_PAREN, #FILE, #LINE);
		advance(ast);
        current_token: *Token = get_current_token(ast);
		attributes: [+]Attribute; //TODO: need to populate as well
        default_vals: [+]Expression;
		args: [+]Variable_Decl_Node;
        for true {
            current_token = get_current_token(ast);
            if current_token.tt == TK_CLOSE_PAREN {
                break;
            } else if current_token.tt == TK_COMMA {
                advance(ast);
                current_token = get_current_token(ast);
            }
            symbol: *Token = current_token;
            advance(ast);
            ast_match(ast, TK_COLON, #FILE, #LINE);
            advance(ast);
            var_decl: Variable_Decl_Node = Variable_Decl_Node{ symbol, 0, extract_type(ast), true };
            current_token = get_current_token(ast);
            if current_token.tt == TK_ASSIGN {
                advance(ast);
                default_val: Expression = ast_create_expr(ast, ast.current_scope, false);
                array_append(default_vals, default_val);
            }
            array_append(args, var_decl);
        }
		ast_match(ast, TK_CLOSE_PAREN, #FILE, #LINE);
		advance(ast);

        current_token = get_current_token(ast);
		return_type: *Type = 0;
        if current_token.tt == TK_ARROW {
            return_type = calloc(1, sizeof(Type));
            // return type
            advance(ast);
            type_: Type = extract_type(ast);
            memcpy(return_type, &type_, sizeof(Type));
        }
		// ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
		// advance(ast);
        // TODO: need to add the variable_decls into the proc_block scope
        current_token = get_current_token(ast);
        proc_block_alloc: *Block_Node = 0;
        if current_token.tt == TK_OPEN_CURLY {
            advance(ast);
            proc_block: Block_Node = create_block(ast, false, ast.current_scope);
            proc_block_alloc = calloc(1, sizeof(Block_Node));
            memcpy(proc_block_alloc, &proc_block, sizeof(Block_Node));
            ast_match(ast, TK_CLOSE_CURLY, #FILE, #LINE);
        } else if current_token.tt == TK_SEMICOLON {
            // do nothing
        } else {
            print_token(current_token);
            panic("Expected '}' or ';' but got something else", #FILE, #LINE);
        }

		proc_type: Type_Proc = Type_Proc{ attributes, args, return_type, 0, proc_block_alloc, default_vals };
		ret: Type = Type { proc_type };
		return ret;
		// todo("handling for Type_Proc", #FILE, #LINE);
	} else if current_token.tt == TK_TYPE {
        // definition of a new type struct
        advance(ast);
        current_token: *Token = get_current_token(ast);
        if current_token.tt == TK_STRUCT {
            fields: [+]Field = array_new(Field);
            advance(ast);
            ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
            advance(ast);
            tag: u8 = 0;
            for true {
                current_token: *Token = get_current_token(ast);
                if current_token.tt == TK_CLOSE_CURLY {
                    break;
                }
                ast_match(ast, TK_WORD, #FILE, #LINE);
                name: *Token = current_token; 
                advance(ast);
                ast_match(ast, TK_COLON, #FILE, #LINE);
                // TODO: handle attributes
                advance(ast);
                field_type: Type = extract_type(ast);
                current_token = get_current_token(ast);
                if current_token.tt == TK_COMMA {
                    advance(ast);
                } else if current_token.tt != TK_CLOSE_CURLY {
                    current_token_str: string = current_token.tok;
                    printf("%s\n".ptr, current_token_str.ptr);
                    panic("Seems you have missed a comma!", #FILE, #LINE);
                }
                field: Field = Field{ name, field_type, tag };
                array_append(fields, field);
                tag = tag + 1;
            }
			// TODO: Attributes
            struct_type: Type_Custom_Decl = Type_Custom_Decl{ 0, fields, array_new(Attribute) };
            ret: Type = Type{ struct_type }; // set the name later after extract_type
            return ret;
        } else if current_token.tt == TK_CHOICE {
            //todo("implement choice types", #FILE, #LINE);
            advance(ast);
			ast_match(ast, TK_OPEN_CURLY, #FILE, #LINE);
            advance(ast);
            tag: u8 = 0;
            fields: [+]Field = array_new(Field);
            // TODO: named fields
            for true {
                current_token: *Token = get_current_token(ast);
                if current_token.tt == TK_CLOSE_CURLY {
                    break;
                }
                ast_match(ast, TK_WORD, #FILE, #LINE);
				name: *Token = current_token;
                t: Type = extract_type(ast);
                current_token = get_current_token(ast);
                if current_token.tt == TK_COMMA {
                    advance(ast);
                } else if current_token.tt != TK_CLOSE_CURLY {
                    // TODO: make this error better kek
                    tmp_str: string = current_token.tok;
                    printf("%s\n".ptr, tmp_str.ptr);
                    panic("Seems you have missed a comma!", #FILE, #LINE);
                }
				field: Field = Field{ name, t, tag };
				array_append(fields, field);
                tag = tag + 1;
            }
			ast_match(ast, TK_CLOSE_CURLY, #FILE, #LINE);
			// TODO: Attributes
			choice_type: Type_Choice = Type_Choice{ 0, fields, array_new(Attribute) };
			ret: Type = Type{ choice_type }; // set the name later after extract_type
			return ret;
        } else {
			panic("Unexpected type class", #FILE, #LINE);
		}
      } else if current_token.tt == TK_STAR {
          // TODO: why is this here lol
          advance(ast);
          inner_type: *Type = calloc(1, sizeof(Type));
          tmp: Type = extract_type(ast);
          memcpy(inner_type, &tmp, sizeof(Type));
          ptr: Type_Pointer = Type_Pointer{ inner_type };
          ret: Type = Type{ ptr };
          return ret;
	} else if current_token.tt == TK_OPEN_SQUARE {
        // Array type
        advance(ast);
        current_token = get_current_token(ast);
        if current_token.tt == TK_PLUS {
            advance(ast);
            ast_match(ast, TK_CLOSE_SQUARE, #FILE, #LINE);
            advance(ast);
            array_type_tmp: Type = extract_type(ast);
            array_type: *Type = calloc(1, sizeof(Type));
            memcpy(array_type, &array_type_tmp, sizeof(Type));
            array: Type_Dynamic_Array = Type_Array{ array_type };
            ret: Type = Type{ array };
            return ret;
        } else if current_token.tt == TK_CLOSE_SQUARE {
            todo("implement slices", #FILE, #LINE);
        } else if current_token.tt == TK_WORD || current_token.tt == TK_NUMBER || is_operator(current_token) {
            // vla or fixed array 
            size_tmp: Expression = ast_create_expr(ast, ast.current_scope, false);
            size: *Expression = calloc(1, sizeof(Expression));
            memcpy(size, &size_tmp, sizeof(Expression));
            ast_match(ast, TK_CLOSE_SQUARE, #FILE, #LINE);
            advance(ast);
            array_type_tmp: Type = extract_type(ast);
            array_type: *Type = calloc(1, sizeof(Type));
            memcpy(array_type, &array_type_tmp, sizeof(Type));
            array: Type_Array = Type_Array{ size, array_type };
            ret: Type = Type{ array };
            return ret;
        }
    } else if current_token.tt == TK_AT {
        // attributes
        attributes: [+]Attribute = extract_attributes(ast);
        tmp: *Token = get_current_token(ast);
        printf("-------------\n".ptr);
        print_token(tmp);
        type_: Type = extract_type(ast);
        match t := type_ {
			Type_Builtin => { todo("(Builtin) not implemented attributes for types outside of proc", #FILE, #LINE); },
			Type_Pointer => { todo("(Pointer) not implemented attributes for types outside of proc", #FILE, #LINE); },
			Type_Proc => {
                for i: i32 = 0; i < array_size(attributes); i = i + 1 {
                    array_append(t.attributes, attributes[i]);
                }
			},
			Type_Array => { todo("(Array) not implemented attributes for types outside of proc", #FILE, #LINE); },
			Type_Dynamic_Array => { todo("(Dynamic_Array) not implemented attributes for types outside of proc", #FILE, #LINE); },
            Type_Choice => { todo("(Choice) not implemented attributes for types outside of proc", #FILE, #LINE); },
            Type_Custom_Decl => { todo("(Custom_Decl) not implemented attributes for types outside of proc", #FILE, #LINE); },
			Type_Custom => { todo("(Custom) not implemented attributes for types outside of proc", #FILE, #LINE); },
            Type_Unknown => { todo("(Unknown) not implemented attributes for types outside of proc", #FILE, #LINE); }
        }
        return type_;
    } else {
		current_token_str: string = current_token.tok;
		printf("%s\n".ptr, current_token_str.ptr);
		todo("Unexpected Token", #FILE, #LINE);
	}
}

