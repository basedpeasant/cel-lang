
isatty: @extern proc(fd: i32) -> i32;
getenv: @extern proc(name: *u8) -> *u8;

// Registry of every source file that gets read, keyed by the filename that
// its tokens are stamped with. Populated from main.ce and expand_includes so
// that report_error_at can look up the problem line instead of re-reading the
// file from disk on every error.
MAX_SOURCE_FILES: i32 = 64;
source_filenames: [64]string;
source_contents: [64]string;
source_files_count: i32 = 0;

register_source: proc(filename: string, src: string) {
    assert(source_files_count < MAX_SOURCE_FILES, "too many source files", #FILE, #LINE);
    source_filenames[source_files_count] = filename;
    source_contents[source_files_count] = src;
    source_files_count = source_files_count + 1;
}

get_src: proc(filename: string) -> string {
    for i: i32 = 0; i < source_files_count; i = i + 1 {
        if strcmp(source_filenames[i], filename) {
            return source_contents[i];
        }
    }
    ret: string = string{ 0, 0 };
    return ret;
}

color_enabled: proc() -> bool {
    tty: i32 = isatty(1);
    if tty == 0 {
        return false;
    }
    env: *u8 = getenv("NO_COLOR".ptr);
    if env != 0 {
        return false;
    }
    return true;
}

sb_push_range: proc(sb: *String_Builder, src: string, from: i32, to: i32) {
    for i: i32 = from; i < to; i = i + 1 {
        if i >= src.length {
            break;
        }
        sb_push(sb, src.ptr[i]);
    }
}

// Find the byte range [start, end) of the line (index is 1-based btw).
// Returns an empty string if the line does not exist.
get_line: proc(src: string, line_number: i32) -> string {
    current: i32 = 1;
    start: i32 = 0;
    src_len: i32 = src.length;
    for i: i32 = 0; i < src_len; i = i + 1 {
        c: u8 = src.ptr[i];
        if c == '\n' {
            if current == line_number {
                end: i32 = i;
                // strip a trailing '\r'
                if end > start && src.ptr[end - 1] == '\r' {
                    end = end - 1;
                }
                ret: string = string{ end - start, src.ptr + start };
                return ret;
            }
            current = current + 1;
            start = i + 1;
        }
    }
    // last line may not end with a newline
    if current == line_number && src_len > start {
        end: i32 = src_len;
        if end > start && src.ptr[end - 1] == '\r' {
            end = end - 1;
        }
        ret: string = string{ end - start, src.ptr + start };
        return ret;
    }
    ret: string = string{ 0, 0 };
    return ret;
}

// Number of context lines shown above and below the error line.
ERROR_CONTEXT: i32 = 2;

count_digits: proc(n: i32) -> i32 {
    if n == 0 {
        return 1;
    }
    count: i32 = 0;
    m: i32 = n;
    for m > 0 {
        count = count + 1;
        m = m / 10;
    }
    return count;
}

// Report an error at an explicit location. `col` and `length` are the
// 0-based byte offset and width of the problem token in the line. Prints the
// location header plus the line with the offending bit highlighted
// in red. Does not exit.
report_error_at: proc(file: string, line_no: i32, col: i32, length: i32, msg: string) {
    on: bool = color_enabled(0);
    src: string = get_src(file);

    start: i32 = col;
    if start < 0 {
        start = 0;
    }
    end: i32 = col + length;

    sb: String_Builder;

    // header: "\n<file>:<line>:<col>:\n"
    sb_push(&sb, '\n');
    sb_push_str(&sb, file);
    sb_push(&sb, ':');
    sb_push_int(&sb, line_no);
    sb_push(&sb, ':');
    sb_push_int(&sb, col + 1);
    sb_push(&sb, ':');
    sb_push(&sb, '\n');

    // "Error: <msg>" in bold red
    if on {
        sb_push(&sb, 27);
        sb_push_str(&sb, "[01;31m");
    }
    sb_push_str(&sb, "Error: ");
    sb_push_str(&sb, msg);
    if on {
        sb_push(&sb, 27);
        sb_push_str(&sb, "[0m");
    }
    sb_push(&sb, '\n');

    // context window: show ERROR_CONTEXT lines above and below the error line
    error_line: string = get_line(src, line_no);
    if error_line.ptr == 0 {
        out: string = sb_to_string(&sb);
        printf("%s".ptr, out.ptr);
        sb_free(&sb);
        return;
    }

    error_line_len: i32 = error_line.length;
    if end > error_line_len {
        end = error_line_len;
    }
    if start > error_line_len {
        start = error_line_len;
    }
    if start > end {
        end = start;
    }

    first_line: i32 = line_no - ERROR_CONTEXT;
    if first_line < 1 {
        first_line = 1;
    }
    last_line: i32 = line_no + ERROR_CONTEXT;
    gutter_width: i32 = count_digits(last_line);

    n: i32 = first_line;
    for n <= last_line {
        ctx_line: string = get_line(src, n);
        if ctx_line.ptr == 0 {
            break;
        }

        digits: i32 = count_digits(n);
        pad: i32 = gutter_width - digits;
        j: i32 = 0;
        for j < pad {
            sb_push(&sb, ' ');
            j = j + 1;
        }
        if on {
            if n == line_no {
                sb_push(&sb, 27);
                sb_push_str(&sb, "[01;31m");
            }
        }
        sb_push_int(&sb, n);
        if on {
            if n == line_no {
                sb_push(&sb, 27);
                sb_push_str(&sb, "[0m");
            }
        }
        sb_push_str(&sb, " | ");

        if n == line_no {
            ctx_len: i32 = ctx_line.length;
            sb_push_range(&sb, ctx_line, 0, start);
            if on {
                sb_push(&sb, 27);
                sb_push_str(&sb, "[31m");
            }
            sb_push_range(&sb, ctx_line, start, end);
            if on {
                sb_push(&sb, 27);
                sb_push_str(&sb, "[0m");
            }
            sb_push_range(&sb, ctx_line, end, ctx_len);
        } else {
            ctx_len2: i32 = ctx_line.length;
            sb_push_range(&sb, ctx_line, 0, ctx_len2);
        }
        sb_push(&sb, '\n');
        n = n + 1;
    }

    out: string = sb_to_string(&sb);
    printf("%s".ptr, out.ptr);
    sb_free(&sb);
}

report_error: proc(token: *Token, msg: string) {
    token_str: string = token.tok;
    report_error_at(token.filename, token.y, token.x, token_str.length, msg);
}

// Report a fatal error for a token and stop compilation
compile_error: proc(token: *Token, msg: string, file: string, line: i32) {
    if DEBUG_MODE {
        printf("%s:%d: compiler_error: %s\n".ptr, file.ptr, line, msg.ptr);
    }
    token_str: string = token.tok;
    report_error_at(token.filename, token.y, token.x, token_str.length, msg);
    exit(1);
}
