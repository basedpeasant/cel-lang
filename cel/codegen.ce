
Generator: type struct {
    output: *String_Builder,
    current_scope: u32,
    scopes: [+]Scope,
    procs: [+]Proc_Header_Node,
    strings: [+]String_Literal,
    types: [+]Type,
    indentation_level: i32,
    main_declaration: string // NOTE: this is for when different args are provided for argc/argv
}

generate_types: proc(g: *Generator) {
    // generating types
    // TODO: make sure that this is changed once match DX becomes better cus this is really
    //       ass
    // TODO: We need to also make it such that it generates types in order so that
    //       declaration order for types doesn't matter
    //       i.e. need to map out dependencies of types ig
    for i: i32 = 0; i < array_size(g.types); i = i + 1 {
        new_type: Type = g.types[i];
        match t := new_type {
            Type_Builtin => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Pointer => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Proc => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Array => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Dynamic_Array => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Choice => {
                if array_size(t.attributes) > 0 {
                    todo("Need to think more about how attributes work for choice types", #FILE, #LINE);
                }
                sb_push_str(g.output, "typedef struct ");
                struct_name: *Token = t.name;
                struct_name_str: string = struct_name.tok;
                sb_push_str(g.output, struct_name_str);
                sb_push(g.output, ' ');
                sb_push_str(g.output, struct_name_str);
                sb_push_str(g.output, ";\n");
            },
            Type_Custom_Decl => {
                // TODO: attributes
                if array_size(t.attributes) > 0 {
                    todo("Need to think more about how attributes work for structs", #FILE, #LINE);
                }
                sb_push_str(g.output, "typedef struct ");
                struct_name: *Token = t.name;
                struct_name_str: string = struct_name.tok;
                sb_push_str(g.output, struct_name_str);
                sb_push(g.output, ' ');
                sb_push_str(g.output, struct_name_str);
                sb_push_str(g.output, ";\n");
            },
            Type_Custom => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Unknown => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            }
        }
    }

    for i: i32 = 0; i < array_size(g.types); i = i + 1 {
        new_type: Type = g.types[i];
        match t := new_type {
            Type_Builtin => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Pointer => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Proc => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Array => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Dynamic_Array => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Choice => {
                if array_size(t.attributes) > 0 {
                    todo("Need to think more about how attributes work for structs", #FILE, #LINE);
                }
                sb_push_str(g.output, "struct ");
                choice_name: *Token = t.name;
                choice_name_str: string = choice_name.tok;
                sb_push_str(g.output, choice_name_str);
                sb_push_str(g.output, " {\n");
                g.indentation_level = g.indentation_level + 1;
                output_indentations(g);
                sb_push_str(g.output, "int _tag;\n");
                output_indentations(g);
                sb_push_str(g.output, "union {\n");
                g.indentation_level = g.indentation_level + 1;
                for i: i32 = 0; i < array_size(t.fields); i = i + 1 {
                    output_indentations(g);
                    field: Field = t.fields[i];
                    c_type: string = get_c_type(field.type_name);
                    field_name: *Token = field.name;
                    sb_push_str(g.output, c_type);
                    sb_push_str(g.output, " _");
                    sb_push_int(g.output, i);
                    sb_push_str(g.output, ";\n");
                }
                g.indentation_level = g.indentation_level - 1;
                output_indentations(g);
                sb_push_str(g.output, "};\n");
                g.indentation_level = g.indentation_level - 1;
                sb_push_str(g.output, "};\n");
            },
            Type_Custom_Decl => {
                // TODO: attributes
                if array_size(t.attributes) > 0 {
                    todo("Need to think more about how attributes work for structs", #FILE, #LINE);
                }
                sb_push_str(g.output, "struct ");
                struct_name: *Token = t.name;
                struct_name_str: string = struct_name.tok;
                sb_push_str(g.output, struct_name_str);
                sb_push_str(g.output, " {\n");
                g.indentation_level = g.indentation_level + 1;
                for i: i32 = 0; i < array_size(t.fields); i = i + 1 {
                    output_indentations(g);
                    field: Field = t.fields[i];
                    c_type: string = get_c_type(field.type_name);
                    field_name: *Token = field.name;
                    sb_push_str(g.output, c_type);
                    sb_push(g.output, ' ');
                    sb_push_str(g.output, field_name.tok);
                    sb_push_str(g.output, ";\n");
                }
                g.indentation_level = g.indentation_level - 1;
                sb_push_str(g.output, "};\n");
            },
            Type_Custom => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            },
            Type_Unknown => {
                unreachable("unexpected type in code generation, only custom types and choice types should be here", #FILE, #LINE);
            }
        }
    }
}

write_start: proc(g: *Generator) {
    sb_push_str(g.output, "typedef enum {\n");
    sb_push_str(g.output, "   false = 0,\n");
    sb_push_str(g.output, "   true = 1\n");
    sb_push_str(g.output, "} __Bool;\n");
    sb_push_str(g.output, "#define NULL 0\n");
    sb_push_str(g.output, "#define bool __Bool\n");
    sb_push_str(g.output, "#define false false\n");
    sb_push_str(g.output, "#define true true\n");
    sb_push_str(g.output, "extern int printf(const char* fmt, ...);\n");
    sb_push_str(g.output, "extern int sprintf(char* str, const char* format, ...);\n");
    sb_push_str(g.output, "void _start();\n");
    // TODO: remove once you can make your own structs
    // sb_push_str(g.output, "#define breakpoint(dummy) __asm__(\"int3\")");

    cel_main_call: string;
    generate_types(g);

    // generating the headers
    for i: i32 = 0; i < array_size(g.procs); i = i + 1 {
        procedure: *Proc_Header_Node = &g.procs[i];
        procedure_name: *Token = procedure.name;
        if strcmp(procedure_name.tok, "main") {
            // TODO: determine the kind of cel_main (_cel_main() or _cel_main(args: []string))
            cel_main: string = "void _cel_main();\n";
            cel_main_call = "\t_cel_main();\n";
            sb_push_str(g.output, cel_main);
            continue;
        }
        attr_string: string = attributes_to_string(procedure.attributes);
        sb_push_str(g.output, attr_string);
        if procedure.return_type == 0 {
            sb_push_str(g.output, "void ");
        } else {
            return_type: Type = procedure.return_type[0];
            c_type_str: string = get_c_type(return_type);
            sb_push_str(g.output, c_type_str);
            sb_push(g.output, ' ');
        }
        sb_push_str(g.output, procedure_name.tok);
        sb_push(g.output, '(');
        // TODO: args
        for i: i32 = 0; i < array_size(procedure.args); i = i + 1 {
            arg: *Variable_Decl_Node = &procedure.args[i];
            walk_variable_decl(g, arg);
            if i != array_size(procedure.args) - 1 {
                sb_push_str(g.output, ", ");
            }
        }
        sb_push_str(g.output, ");\n");
    }

    // generate all the string_literals
    for i: i32 = 0; i < array_size(g.strings); i = i + 1 {
        sb_push_str(g.output, "static const string ");
        index: string = itostr(i);
        sb_push(g.output, 's');
        sb_push_str(g.output, index);
        string_literal: String_Literal = g.strings[i];
        str: string = string_literal.str;
        sb_push_str(g.output, " = {");
        length_str: string = itostr(str.length);
        sb_push_str(g.output, length_str);
        sb_push_str(g.output, ", (const char[");
        sb_push_str(g.output, length_str);
        sb_push_str(g.output, "]){");
        for j: i32 = 0; j < str.length; j = j + 1 {
            sb_push_str(g.output, "'");
            if str.ptr[j] == '\\' {
                sb_push(g.output, str.ptr[j]);
                j = j + 1;
                sb_push(g.output, str.ptr[j]);
            } else {
                sb_push(g.output, str.ptr[j]);
            }
            sb_push_str(g.output, "'");
            if j < str.length - 1 {
                sb_push_str(g.output, ", ");
            }
        }
        sb_push_str(g.output, "}};\n");
    }

    g.main_declaration = "void _cel_main()\n"; // TODO: change this to be dynamic later

    // write the c main
    sb_push_str(g.output, "int main(int argc, char** argv) {\n");
    sb_push_str(g.output, cel_main_call);
    sb_push_str(g.output, "}\n\n");
}

compile: proc(_x: i32) {
    args_len: i32 = 7;
    args: [8]*u8 = [ 
        "cc".ptr, 
        "-std=c99".ptr,
        "-fno-builtin".ptr,
        "-ggdb".ptr,
        "out.c".ptr, 
        "-o".ptr,
        "out".ptr,
        0
    ];
    printf("Running ".ptr);
    for i: i32 = 0; i < args_len; i = i + 1 {
        printf("%s ".ptr, args[i]);
    }
    printf("\n".ptr);

    res: i32 = run_process("cc", args);
    printf("status: %d\n".ptr, res);
}

output_indentations: proc(g: *Generator) {
    for i: i32 = 0; i < g.indentation_level; i = i + 1 {
        sb_push_str(g.output, "    ");
    }
}

// Map an Attribute kind to its C representation.
get_attribute_string: proc(attribute: *Attribute) -> string {
    if attribute.kind == ATTRIBUTE_EXTERN {
        return "extern";
    } else if attribute.kind == ATTRIBUTE_STATIC {
        return "static";
    } else if attribute.kind == ATTRIBUTE_CONST {
        return "const";
    } else {
        unreachable("Unknown attribute supplied here (this should have failed earlier)", #FILE, #LINE);
    }
}

// Concatenate the C representation of every attribute in `attributes`
// (e.g. "extern ", "static ", "const ") so it can be prepended to a type.
attributes_to_string: proc(attributes: [+]Attribute) -> string {
    sb: String_Builder;
    if attributes != 0 {
        for i: i32 = 0; i < array_size(attributes); i = i + 1 {
            attribute: Attribute = attributes[i];
            attribute_string: string = get_attribute_string(&attribute);
            sb_push_str(&sb, attribute_string);
            sb_push(&sb, ' ');
        }
    }
    ret: string = sb_to_string(&sb);
    sb_free(&sb);
    return ret;
}

get_c_type: proc(type__: Type) -> string {
    type_: Type = type__; // NOTE/TODO: this is only here cus of a bug
    // NOTE: attributes are folded into the returned type string here
    //       (`@const *u8` becomes `const unsigned char*`, `@extern proc`
    //       becomes `extern int`). This means `@const` on a pointer
    //       means pointer-to-const; a const pointer is not representable.
    match t := type_ {
        Type_Builtin => {
            c_type: string;
            if t.kind == TYPE_U8 {
                c_type = "unsigned char";
            } else if t.kind == TYPE_U16 {
                c_type = "unsigned short";
            } else if t.kind == TYPE_U32 {
                c_type = "unsigned int";
            } else if t.kind == TYPE_U64 {
                c_type = "unsigned long";
            } else if t.kind == TYPE_I8 {
                c_type = "char";
            } else if t.kind == TYPE_I16 {
                c_type = "short";
            } else if t.kind == TYPE_I32 {
                c_type = "int";
            } else if t.kind == TYPE_I64 {
                c_type = "long";
            } else if t.kind == TYPE_BOOL {
                c_type = "bool";
            } else if t.kind == TYPE_STRING {
                c_type = "string";
            } else if t.kind == TYPE_VOID_PTR {
                c_type = "void*";
            } else {
                printf("UNKNOWN TYPE %d\n".ptr, t.kind);
                assert(false, "Unhandled TYPE", #FILE, #LINE);
            }
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            sb_push_str(&sb, c_type);
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Pointer => {
            inner: *Type = t.inner;
            c_type: string = get_c_type(inner[0]);
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            sb_push_str(&sb, c_type);
            sb_push_str(&sb, "*");
            // memory allocated here without freeing
            // not like theres other parts of the code that doesn't
            // do this lol. problem for later;
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Proc => {
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            if t.return_type == 0 {
                sb_push_str(&sb, "void");
            } else {
                c_type: string = get_c_type(t.return_type[0]);
                sb_push_str(&sb, c_type);
            }
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Array => {
            array_type: string = get_c_type(t.array_type[0]);
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            sb_push_str(&sb, array_type);
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Dynamic_Array => {
            array_type: string = get_c_type(t.array_type[0]);
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            sb_push_str(&sb, array_type);
            sb_push(&sb, '*');
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Choice => {
            todo("get_c_type (Type_Choice)", #FILE, #LINE);
        },
        Type_Custom_Decl => {
            todo("get_c_type (Type_Custom_Decl)", #FILE, #LINE);
        },
        Type_Custom => {
            name: *Token = t.name;
            sb: String_Builder;
            sb_push_str(&sb, attributes_to_string(t.attributes));
            sb_push_str(&sb, name.tok);
            ret: string = sb_to_string(&sb);
            sb_free(&sb);
            return ret;
        },
        Type_Unknown => {
            assert(t.resolved, "an unresolved Type_Unknown reached get_c_type", #FILE, #LINE);
            return get_c_type(t.type_[0]);
        }
    } 
}

walk_proc: proc(g: *Generator, proc_: *Type_Proc) {
    name: *Token = proc_.name;
    if proc_.is_generic {
        // TODO:
        todo("Codegen for generic procedures", #FILE, #LINE);
    }
    if strcmp(name.tok, "main") {
        sb_push_str(g.output, g.main_declaration);
    } else {
        attr_string: string = attributes_to_string(proc_.attributes);
        sb_push_str(g.output, attr_string);
        if proc_.return_type != 0 {
            // TODO: using [0] for dereference lol
            c_type_string: string = get_c_type(proc_.return_type[0]);
            sb_push_str(g.output, c_type_string);
            sb_push(g.output, ' ');
        } else {
            sb_push_str(g.output, "void ");
        }
        sb_push_str(g.output, name.tok);
        sb_push_str(g.output, "(");
        for i: i32 = 0; i < array_size(proc_.args); i = i + 1 {
            arg: *Variable_Decl_Node = &proc_.args[i];
            walk_variable_decl(g, arg);
            if i != array_size(proc_.args) - 1 {
                sb_push_str(g.output, ", ");
            }
        }
        if proc_.block != 0 {
            sb_push_str(g.output, ")\n");
        } else {
            sb_push_str(g.output, ")");
        }
    }
    if proc_.block != 0 {
        walk_block(g, proc_.block, false);
    } else {
        // this should be a forward declaration
        sb_push_str(g.output, ";\n");
    }
}

// converts int to an allocated string 
itostr: proc(i: i64) -> string {
    buffer: [20]u8;
    remainder: i64 = 0;
    index: i32 = 0;

    if i == 0 {
        return "0";
    }

    for i != 0 {
        remainder = i % 10;
        buffer[index] = remainder + 48;
        index = index + 1;
        i = i / 10;
    }
    
    ptr: *u8 = calloc(index, sizeof(char));
    j: i32 = 0;
    for i: i32 = index - 1; i >= 0; i = i - 1 {
        ptr[j] = buffer[i];
        j = j + 1;
    }

    ret: string = string{ index , ptr };
    return ret;
}

walk_expression: proc(g: *Generator, expr_: *Expression) {
    expr: *Expression = expr_;
    match e := expr {
        Binary_Node => {
            sb_push_str(g.output, "(");
            walk_expression(g, e.lhs);
            if e.op == OP_ADD {
                sb_push_str(g.output, " + ");
            } else if e.op == OP_SUB {
                sb_push_str(g.output, " - ");
            } else if e.op == OP_MUL {
                sb_push_str(g.output, " * ");
            } else if e.op == OP_DIV {
                sb_push_str(g.output, " / ");
            } else if e.op == OP_OR {
                sb_push_str(g.output, " | ");
            } else if e.op == OP_LOGICAL_OR {
                sb_push_str(g.output, " || ");
            } else if e.op == OP_LOGICAL_AND {
                sb_push_str(g.output, " && ");
            } else if e.op == OP_GT {
                sb_push_str(g.output, " > ");
            } else if e.op == OP_GTE {
                sb_push_str(g.output, " >= ");
            } else if e.op == OP_LT {
                sb_push_str(g.output, " < ");
            } else if e.op == OP_LTE {
                sb_push_str(g.output, " <= ");
            } else if e.op == OP_EQUAL {
                sb_push_str(g.output, " == ");
            } else if e.op == OP_NOT_EQUAL {
                sb_push_str(g.output, " != ");
            } else if e.op == OP_REFERENCE {
                sb_push_str(g.output, " & ");
            } else if e.op == OP_ASSIGN {
                sb_push_str(g.output, " = ");
            } else if e.op == OP_ACCESS {
                if e.needs_ptr_deref { sb_push_str(g.output, "->"); }
                else           { sb_push_str(g.output, ".");  }
                //TODO: this looks right actually not sure why I put this as unreachable
                // unreachable("Access operation should be handled elsewhere", #FILE, #LINE);
            } else if e.op == OP_ARRAY_INDEX {
                //TODO: this looks right actually not sure why I put this as unreachable
                unreachable("Array indexing should be handled elsewhere", #FILE, #LINE);
            } else if e.op == OP_NOT {
                unreachable("Unary operator '!' should not appear here", #FILE, #LINE);
            } else if e.op == OP_AND {
                unreachable("Unary operator '&' should not appear here", #FILE, #LINE);
            } else if e.op == OP_LEFT_SHIFT {
                sb_push_str(g.output, " << ");
            } else if e.op == OP_RIGHT_SHIFT {
                sb_push_str(g.output, " >> ");
            } else if e.op == OP_BITWISE_XOR {
                sb_push_str(g.output, " ^ ");
            } else if e.op == OP_ADD_ASSIGN {
                sb_push_str(g.output, " += ");
            } else if e.op == OP_SUB_ASSIGN {
                sb_push_str(g.output, " -= ");
            } else if e.op == OP_MOD {
                sb_push_str(g.output, " % ");
            } else {
                panic("Operator codegen not implemented yet", #FILE, #LINE);
            }
            walk_expression(g, e.rhs);
            sb_push_str(g.output, ")");
        },
        Number_Node => {
            sb_push_str(g.output, itostr(e.val));
        },
        Variable_Node => {
            token: *Token = e.symbol;
            str: string = token.tok; 
            sb_push_str(g.output, str);
        },
        Call_Node => {
            token: *Token = e.name;
            str: string = token.tok; 
            sb_push_str(g.output, str);
            sb_push_str(g.output, "(");
            for i: i32 = 0; i < array_size(e.args); i = i + 1 {
                walk_expression(g, &e.args[i]);
                if i != array_size(e.args) - 1 {
                    sb_push_str(g.output, ", ");
                }
            }
            sb_push_str(g.output, ")");
        },
        String_Literal => {
            string_literal: string = e.str;
            sb_push(g.output, 's');
            index: string = itostr(e.index);
            sb_push_str(g.output, index);
        },
        Unary_Node => {
            if e.op == OP_BITWISE_XOR {
                sb_push_str(g.output, "^");
            } else if e.op == OP_AND {
                sb_push_str(g.output, "&");
            } else if e.op == OP_NOT {
                sb_push_str(g.output, "!");
            } else if e.op == OP_BITWISE_NOT {
                sb_push_str(g.output, "~");
            } else if e.op == OP_REFERENCE {
                sb_push_str(g.output, "&");
            } else if e.op == OP_ARRAY_INDEX {
                // TODO: I think this might not work with multi dimensional arrays 
                walk_expression(g, e.base);
                sb_push_str(g.output, "[");
                walk_expression(g, e.expr);
                sb_push_str(g.output, "]");
                return;
            } else if e.op == OP_DEREF {
                sb_push_str(g.output, "*");
            } else {
                printf("%d\n".ptr, e.op);
                panic("not implemented unary operation yet or invalid unary operation", #FILE, #LINE);
            }
            walk_expression(g, e.base);
        },
        Struct_Init_Node => {
            if e.is_choice {
                sb_push(g.output, '{');
                assert(array_size(e.exprs) == 1, "Choice type initializer MUST have only one value", #FILE, #LINE);
                sb_push_str(g.output, "._tag = ");
                sb_push_int(g.output, e.tag);
                
                sb_push(g.output, ',');
                sb_push_str(g.output, "._");
                sb_push_int(g.output, e.tag);
                sb_push(g.output, '=');
                walk_expression(g, &e.exprs[0]);
                sb_push(g.output, '}');
            } else {
                sb_push(g.output, '{');
                for i: i32 = 0; i < array_size(e.exprs); i = i + 1 {
                    walk_expression(g, &e.exprs[i]);
                    if i != array_size(e.exprs) - 1 {
                        sb_push(g.output, ',');
                    }
                }
                sb_push(g.output, '}');
            }
        },
        Array_Literal => {
            // TODO: can't zero the rest because we don't know how much is there as of right now
            sb_push(g.output, '{');
            for i: i32 = 0; i < array_size(e.elements); i = i + 1 {
                walk_expression(g, &e.elements[i]);
                if i != array_size(e.elements) - 1 {
                    sb_push(g.output, ',');
                }
            }
            sb_push(g.output, '}');
        }
    }
}

walk_variable_decl: proc(g: *Generator, variable_decl: *Variable_Decl_Node) {
    var_type: Type = variable_decl.var_type;
    is_arg: bool = variable_decl.is_arg;
    skip: bool = false;

    // TODO: doing it this way won't work for multi dimensional arrays
    is_arr: bool = false;
    is_type_custom: bool = false;
    size_expr: *Expression = 0;

    match t := var_type {
        Type_Builtin => {
            c_type_str: string = get_c_type(var_type);
            sb_push_str(g.output, c_type_str);
            // don't forget the space
            sb_push(g.output, ' ');
        },
        Type_Pointer => {
            c_type_str: string = get_c_type(var_type);
            sb_push_str(g.output, c_type_str);
            sb_push(g.output, ' ');
        },
        Type_Proc => {
            walk_proc(g, t);
            skip = true;
        },
        Type_Array => {
            c_type_str: string = get_c_type(var_type);
            sb_push_str(g.output, c_type_str);
            sb_push(g.output, ' ');
            is_arr = true;
            size_expr = t.size;
        },
        Type_Dynamic_Array => {
            c_type_str: string = get_c_type(var_type);
            sb_push_str(g.output, c_type_str);
            sb_push(g.output, ' ');
        },
        Type_Choice => {
            todo("implement walk for Type_Choice", #FILE, #LINE);
        },
        Type_Custom_Decl => {
            unreachable("types should not be in the list of statements in any blocks", #FILE, #LINE);
        },
        Type_Custom => {
            type_str: string = get_c_type(var_type);
            sb_push_str(g.output, type_str);
            sb_push(g.output, ' ');
            is_type_custom = true;
        },
        Type_Unknown => {
            assert(t.resolved, "an unresolved type of `Type_Unknown` has appeared in codegen", #FILE, #LINE);
            c_type_str: string = get_c_type(t.type_[0]);
            sb_push_str(g.output, c_type_str);
            sb_push(g.output, ' ');
        }
    }
    if !skip {
        name: *Token = variable_decl.symbol;
        sb_push_str(g.output, name.tok);
        if !is_arg {
            if is_arr {
                sb_push(g.output, '[');
                walk_expression(g, size_expr);
                sb_push(g.output, ']');
            }
            if variable_decl.rhs != 0 {
                sb_push_str(g.output, " = ");
                walk_expression(g, variable_decl.rhs);
            } else {
                if is_arr {
                    sb_push_str(g.output, " = {0}");
                } else if is_type_custom {
                    sb_push_str(g.output, " = {0}");
                }
            }
        }
    }
}

walk_decl: proc(g: *Generator, decl_: *Decl_Node) {
    decl: *Decl_Node = decl_; // NOTE/TODO: this is because of bug lol
    match n := decl {
        Variable_Decl_Node => {
            walk_variable_decl(g, n);
            var_type: Type = n.var_type;
            // TODO: change this once DX gets better lol
            //       cus this is obviously insanely stupid
            //       we're putting a ; for every decl thats
            //       not a proc
            match _n := var_type {
                Type_Builtin => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Pointer => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Proc => {},
                Type_Array => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Dynamic_Array => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Choice => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Custom_Decl => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Custom => {
                    sb_push_str(g.output, ";\n");
                },
                Type_Unknown => {
                    sb_push_str(g.output, ";\n");
                }
            }
        }
    }
}

walk_if_node: proc(g: *Generator, if_node: *If_Node) {
    if if_node.is_else {
        output_indentations(g);
        sb_push_str(g.output, "else\n");
    }
    if if_node.condition != 0 {
        sb_push_str(g.output, "if (");
        walk_expression(g, if_node.condition);
        sb_push_str(g.output, ")\n");
        walk_block(g, &if_node.block, false);
    } else {
        assert(if_node.is_else, "non else part of the If Node cannot have a null condition", #FILE, #LINE);
        walk_block(g, &if_node.block, false);
    }
    if if_node.next != 0 {
        walk_if_node(g, if_node.next);
    }
}

walk_for_node: proc(g: *Generator, for_node: *For_Node) {
    if for_node.is_classic_for {
        sb_push_str(g.output, "for(");
        assert(for_node.init != 0, "cannot have empty statements in for loops", #FILE, #LINE);
        assert(for_node.condition != 0, "cannot have empty conditions in for loops", #FILE, #LINE);
        assert(for_node.post != 0, "cannot have empty post-expressions in for loops", #FILE, #LINE);

        walk_statement(g, for_node.init); // probably already adds a semicolon
        walk_expression(g, for_node.condition);
        sb_push_str(g.output, ";");
        walk_expression(g, for_node.post);

        sb_push_str(g.output, ")\n");
        walk_block(g, &for_node.block, false);
    } else {
        sb_push_str(g.output, "while(");
        if for_node.condition == 0 {
            sb_push_str(g.output, "true");
        } else {
            walk_expression(g, for_node.condition);
        }
        sb_push_str(g.output, ")\n");
        walk_block(g, &for_node.block, false);
    }
}

walk_match_node: proc(g: *Generator, m: *Match_Node) {
    //todo("implement codegen for match blocks", #FILE, #LINE);
    subject: *Variable_Decl_Node = m.subject;
    subject_symbol: *Token = subject.symbol;

    sb_push_str(g.output, "switch(");
    walk_expression(g, subject.rhs);
    // sb_push_str(g.output, subject_symbol.tok);
    // TODO: consider the case where you need to use a reference because the type is
    //       not a pointer since we DO NOT WANT to create a copy but use a reference 
    if m.needs_deref {
        sb_push_str(g.output, "->_tag) {\n");
    } else {
        sb_push_str(g.output, "._tag) {\n");
    }
    for i: i32 = 0; i < array_size(m.blocks); i = i + 1 {
        field: *Field = &m.fields[i];
        field_name: *Token = field.name;
        output_indentations(g);
        sb_push_str(g.output, "case ");
        sb_push_int(g.output, field.tag);
        sb_push_str(g.output, ": {\n");

        walk_block(g, &m.blocks[i], true);
        g.indentation_level = g.indentation_level + 1;
        output_indentations(g);
        sb_push_str(g.output, "break;\n");
        g.indentation_level = g.indentation_level - 1;
        output_indentations(g);
        sb_push_str(g.output, "}\n");
    }
    output_indentations(g);
    sb_push_str(g.output, "}\n");
    // TODO: consider adding "default: (?)"
}

walk_expression_with_block: proc(g: *Generator, expr_block_: *Expression_Statement_With_Block) {
    expr_block: *Expression_Statement_With_Block = expr_block_;
    match e_block := expr_block {
        If_Node => {
            walk_if_node(g, e_block);
        },
        For_Node => {
            walk_for_node(g, e_block);
        },
        Match_Node => {
            walk_match_node(g, e_block);
        }
    }
}

walk_statement: proc(g: *Generator, s: *Statement) {
    statement: *Statement = s;
    match n := statement {
        Expression_Statement => {
            es: *Expression_Statement = n;
            match e := es {
                Expression => {
                    walk_expression(g, e);
                    sb_push_str(g.output, ";\n");
                },
                Expression_Statement_With_Block => {
                    walk_expression_with_block(g, e);
                }
            }
        },
        Decl_Node => {
            walk_decl(g, n);
            // NOTE: semi-colon ; is added in walk_decl instead of here because
            //       its too troublesome to check if the decl_node is a proc or not
        },
        Return_Node => {
            if n.expr == 0 {
                sb_push_str(g.output, "return;");
            } else {
                sb_push_str(g.output, "return ");
                walk_expression(g, n.expr);
                sb_push_str(g.output, ";\n");
            }
        }
    }
}

walk_block: proc(g: *Generator, block: *Block_Node, skip_braces: bool) {
    if block.scope != 0 && !skip_braces {
        output_indentations(g);
        sb_push_str(g.output, "{\n");
    }
    save: u32 = g.current_scope;
    g.indentation_level = g.indentation_level + 1;

    for i: i32 = 0; i < array_size(block.statements); i = i + 1 {
        statement: Statement = block.statements[i];
        if block.scope != 0 {
            output_indentations(g);
        }
        walk_statement(g, &statement);
        // TODO/NOTE: ideally the semicolon would be added here instead of all the other places
        //            but because the proc are part of the variable decl and the choice 
        //            DX isn't good enough yet this is the only way we can do it
        // sb_push_str(g.output, ";\n");
    }

    g.indentation_level = g.indentation_level - 1;
    if block.scope != 0 && !skip_braces {
        output_indentations(g);
        sb_push_str(g.output, "}\n");
    }
}

codegen_start: proc(ast: *Ast) {
    g: *Generator = calloc(1, sizeof(Generator));
    sb: *String_Builder = calloc(1, sizeof(String_Builder));
    g.procs = ast.procs;
    g.output = sb;
    g.indentation_level = 0;
    g.strings = ast.strings;
    g.types = ast.types;
    g.scopes = ast.scopes;
    
    write_start(g);

    //TODO: walk root block
    walk_block(g, &ast.root_block, false);

    write_string_builder_to_file(sb, "out.c");
    compile(0);
    
    free(sb);
    free(g);
}
